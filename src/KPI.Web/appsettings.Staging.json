{
  "ConnectionStrings": {
    "DefaultConnection": "Server=kpi-db-staging;Database=KPI_System_Staging;User Id=sa;Password=Staging@Napa2026!;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [STAGING] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/kpi-staging-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "SmtpSettings": {
    "Host": "smtp.staging.napa.vn",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "staging-notify@napa.vn",
    "Password": "StagingPassword2026",
    "SenderEmail": "no-reply-staging@napa.vn",
    "SenderName": "[STAGING] Hệ thống KPI Học viện NAPA"
  },
  "AllowedHosts": "*"
}
