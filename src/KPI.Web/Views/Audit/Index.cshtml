@model IEnumerable<KPI.Domain.Entities.Identity.AuditLog>
@{
    ViewData["Title"] = "Nhật ký Kiểm toán Hệ thống (Audit Trail)";
    var availableActions = (List<string>)(ViewBag.AvailableActions ?? new List<string>());
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalItems = (int)(ViewBag.TotalItems ?? 0);
}

<div class="container-fluid py-3">
    <!-- Header Page -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-dark">
                <i class="bi bi-clock-history text-primary me-2"></i>Nhật ký Kiểm toán (Audit Trail)
            </h2>
            <p class="text-muted small mb-0">Theo dõi toàn bộ vết thay đổi dữ liệu, đăng nhập và truy vấn theo chuẩn an ninh ISO 27001.</p>
        </div>
        <div>
            <span class="badge bg-primary-subtle text-primary fs-6 px-3 py-2 rounded-pill">
                Tổng số: @totalItems bản ghi kiểm toán
            </span>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Từ khóa tìm kiếm</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control border-start-0" placeholder="Tên bảng, IP, Username..." value="@ViewBag.Search" />
                    </div>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1">Loại hành động</label>
                    <select name="actionType" class="form-select form-select-sm">
                        <option value="">-- Tất cả hành động --</option>
                        @foreach (var act in availableActions)
                        {
                            <option value="@act" selected="@(ViewBag.ActionType == act ? "selected" : null)">@act</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1">Từ ngày</label>
                    <input type="date" name="fromDate" class="form-control form-control-sm" value="@ViewBag.FromDate" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1">Đến ngày</label>
                    <input type="date" name="toDate" class="form-control form-control-sm" value="@ViewBag.ToDate" />
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm px-3 flex-grow-1">
                        <i class="bi bi-funnel me-1"></i> Lọc dữ liệu
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Audit Logs Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-muted text-uppercase">
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th style="width: 170px;">Thời gian (UTC)</th>
                        <th>Người thao tác</th>
                        <th>Hành động</th>
                        <th>Thực thể & Mã</th>
                        <th>Địa chỉ IP</th>
                        <th style="width: 120px;" class="text-center">Chi tiết</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-folder-x fs-1 d-block mb-2 text-secondary"></i>
                                Không tìm thấy bản ghi kiểm toán nào phù hợp với điều kiện lọc.
                            </td>
                        </tr>
                    }
                    @foreach (var log in Model)
                    {
                        var badgeClass = log.Action switch
                        {
                            "LOGIN_SUCCESS" => "bg-success text-white",
                            "LOGIN_FAILED" => "bg-danger text-white",
                            "LOGOUT" => "bg-secondary text-white",
                            "INSERT" => "bg-info text-dark",
                            "UPDATE" => "bg-warning text-dark",
                            "DELETE" => "bg-danger text-white",
                            _ => "bg-light text-dark border"
                        };

                        <tr>
                            <td class="text-muted font-monospace">#@log.Id</td>
                            <td>
                                <div class="fw-semibold">@log.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</div>
                                <div class="text-muted" style="font-size: 11px;">@log.CreatedAt.ToString("zzz")</div>
                            </td>
                            <td>
                                @if (log.User != null)
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 13px;">
                                            @log.User.Username.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-semibold">@log.User.Username</div>
                                            <div class="text-muted" style="font-size: 11px;">@log.User.Email</div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Hệ thống / Ẩn danh</span>
                                }
                            </td>
                            <td>
                                <span class="badge @badgeClass fw-semibold px-2 py-1">@log.Action</span>
                            </td>
                            <td>
                                <div class="fw-bold">@log.EntityName</div>
                                @if (log.EntityId > 0)
                                {
                                    <div class="text-muted font-monospace" style="font-size: 11px;">ID: @log.EntityId</div>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark font-monospace border">@log.IpAddress</span>
                            </td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(log.OldValues) || !string.IsNullOrEmpty(log.NewValues))
                                {
                                    <button type="button" class="btn btn-outline-primary btn-sm px-2 py-1 view-diff-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#diffModal"
                                            data-id="@log.Id"
                                            data-action="@log.Action"
                                            data-entity="@log.EntityName"
                                            data-old='@log.OldValues'
                                            data-new='@log.NewValues'>
                                        <i class="bi bi-code-slash me-1"></i> So sánh
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <div class="text-muted small">
                    Trang <strong>@currentPage</strong> / <strong>@totalPages</strong>
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@ViewBag.Search" asp-route-actionType="@ViewBag.ActionType" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        @for (var i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search" asp-route-actionType="@ViewBag.ActionType" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate">@i</a>
                            </li>
                        }
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@ViewBag.Search" asp-route-actionType="@ViewBag.ActionType" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Modal xem chi tiết JSON Diff -->
<div class="modal fade" id="diffModal" tabindex="-1" aria-labelledby="diffModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title fw-bold" id="diffModalLabel">
                    <i class="bi bi-file-earmark-diff text-primary me-2"></i>Chi tiết Thay đổi Dữ liệu Kiểm toán
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-secondary-subtle text-secondary fw-semibold">DỮ LIỆU CŨ (OLD VALUES)</span>
                        </div>
                        <pre class="bg-dark text-light p-3 rounded-3 small font-monospace" style="max-height: 350px; overflow-y: auto;" id="oldValuesPre">Không có</pre>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-success-subtle text-success fw-semibold">DỮ LIỆU MỚI (NEW VALUES)</span>
                        </div>
                        <pre class="bg-dark text-light p-3 rounded-3 small font-monospace" style="max-height: 350px; overflow-y: auto;" id="newValuesPre">Không có</pre>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const diffButtons = document.querySelectorAll('.view-diff-btn');
            const oldPre = document.getElementById('oldValuesPre');
            const newPre = document.getElementById('newValuesPre');

            diffButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    const rawOld = this.getAttribute('data-old');
                    const rawNew = this.getAttribute('data-new');

                    try {
                        oldPre.textContent = rawOld ? JSON.stringify(JSON.parse(rawOld), null, 2) : '(Trống / Bản ghi mới tạo)';
                    } catch {
                        oldPre.textContent = rawOld || '(Trống)';
                    }

                    try {
                        newPre.textContent = rawNew ? JSON.stringify(JSON.parse(rawNew), null, 2) : '(Trống / Bản ghi bị xóa)';
                    } catch {
                        newPre.textContent = rawNew || '(Trống)';
                    }
                });
            });
        });
    </script>
}
