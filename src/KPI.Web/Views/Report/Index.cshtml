@model KPI.Web.ViewModels.Report.ReportIndexViewModel
@{
    ViewData["Title"] = "Trung Tâm Báo Cáo & Phân Tích Dữ Liệu Hiệu Suất";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var s = Model.Summary;
    var f = Model.Filter;
}

<div class="content-body pb-5">
    @Html.AntiForgeryToken()

    <!-- PAGE HEADER -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 no-print">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb breadcrumb-dark mb-1">
                    <li class="breadcrumb-item"><a href="/Dashboard">Trang chủ</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Báo cáo & Phân tích Đa chiều</li>
                </ol>
            </nav>
            <h1 class="page-title text-gradient-primary mb-1">
                <i class="bi bi-graph-up-arrow me-2 text-primary"></i>Trung Tâm Báo Cáo & Phân Tích Dữ Liệu KPI
            </h1>
            <p class="text-secondary small mb-0">
                Thống kê hiệu suất toàn diện, Bảng xếp hạng cán bộ, Phân bổ chuông Gauss, Xuất Excel/PDF chuyên nghiệp
            </p>
        </div>

        <!-- EXPORT ENGINE & ACTION BUTTONS -->
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="dropdown">
                <button class="btn btn-outline-success btn-sm rounded-pill px-3 dropdown-toggle shadow-sm" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-download me-1"></i>Xuất Báo Cáo
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                    <li>
                        <a class="dropdown-item py-2" href="/Report/ExportExcel?periodId=@f.PeriodId" target="_blank">
                            <i class="bi bi-file-earmark-excel text-success me-2 fs-5"></i>Xuất Excel Chuyên Nghiệp (.xlsx)
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item py-2" href="/Report/ExportPdf?periodId=@f.PeriodId" target="_blank">
                            <i class="bi bi-file-earmark-pdf text-danger me-2 fs-5"></i>Xuất PDF Chuẩn In A4 (.pdf)
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item py-2" href="/Report/ExportCsv?periodId=@f.PeriodId" target="_blank">
                            <i class="bi bi-filetype-csv text-primary me-2 fs-5"></i>Tải Dữ Liệu Thô (.csv)
                        </a>
                    </li>
                </ul>
            </div>

            <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalScheduleReport">
                <i class="bi bi-calendar-check me-1"></i>Đặt Lịch Báo Cáo
            </button>

            <button type="button" class="btn btn-outline-dark btn-sm rounded-pill px-3" onclick="window.print()">
                <i class="bi bi-printer me-1"></i>In Nhanh (Ctrl+P)
            </button>
        </div>
    </div>

    <!-- SMART FILTER BAR (STICKY & MULTI-SELECT & PRESETS) -->
    <div class="card-enterprise p-3 mb-4 sticky-top no-print" style="top: 70px; z-index: 1020;">
        <form method="get" action="/Report/Index" id="frmReportFilter">
            <input type="hidden" name="tab" id="activeTabInput" value="@Model.CurrentTab" />
            <input type="hidden" name="preset" id="activePresetInput" value="@f.Preset" />

            <div class="row g-2 align-items-center">
                <!-- 1. Kỳ đánh giá -->
                <div class="col-md-3">
                    <label class="form-label small text-secondary mb-1 fw-semibold">Kỳ đánh giá:</label>
                    <select name="PeriodId" class="form-select form-select-sm" onchange="this.form.submit()">
                        @foreach (var period in Model.Periods)
                        {
                            <option value="@period.Id" selected="@(period.Id == f.PeriodId)">
                                @period.Name (@period.Year)
                            </option>
                        }
                    </select>
                </div>

                <!-- 2. Phòng ban (Multi-select) -->
                <div class="col-md-3">
                    <label class="form-label small text-secondary mb-1 fw-semibold">Phòng ban / Đơn vị:</label>
                    <select name="DepartmentIds" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- Tất cả các đơn vị --</option>
                        @foreach (var dept in Model.Departments)
                        {
                            <option value="@dept.Id" selected="@(f.DepartmentIds != null && f.DepartmentIds.Contains(dept.Id))">
                                @dept.Name
                            </option>
                        }
                    </select>
                </div>

                <!-- 3. Xếp loại -->
                <div class="col-md-2">
                    <label class="form-label small text-secondary mb-1 fw-semibold">Mức xếp loại:</label>
                    <select name="Statuses" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- Tất cả mức --</option>
                        <option value="Hoàn thành xuất sắc nhiệm vụ" selected="@(f.Statuses != null && f.Statuses.Contains("Hoàn thành xuất sắc nhiệm vụ"))">Xuất sắc (>=90)</option>
                        <option value="Hoàn thành tốt nhiệm vụ" selected="@(f.Statuses != null && f.Statuses.Contains("Hoàn thành tốt nhiệm vụ"))">Tốt (70-89.9)</option>
                        <option value="Hoàn thành nhiệm vụ" selected="@(f.Statuses != null && f.Statuses.Contains("Hoàn thành nhiệm vụ"))">Đạt (50-69.9)</option>
                        <option value="Không hoàn thành nhiệm vụ" selected="@(f.Statuses != null && f.Statuses.Contains("Không hoàn thành nhiệm vụ"))">Không đạt (&lt;50)</option>
                    </select>
                </div>

                <!-- 4. Tìm kiếm từ khóa -->
                <div class="col-md-3">
                    <label class="form-label small text-secondary mb-1 fw-semibold">Tìm kiếm cán bộ:</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="SearchTerm" class="form-control border-start-0" placeholder="Tên, mã CB..." value="@f.SearchTerm" />
                        <button class="btn btn-outline-secondary" type="submit">Lọc</button>
                    </div>
                </div>

                <!-- 5. Reset -->
                <div class="col-md-1 d-flex align-items-end">
                    <a href="/Report/Index?periodId=@f.PeriodId" class="btn btn-outline-secondary btn-sm w-100 rounded-pill" title="Đặt lại bộ lọc">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </div>

            <!-- SMART PRESETS & SAVED FILTERS -->
            <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top flex-wrap gap-2">
                <div class="d-flex align-items-center gap-1 flex-wrap">
                    <span class="small text-muted me-1"><i class="bi bi-lightning-charge-fill text-warning"></i>Bộ lọc nhanh:</span>
                    <button type="button" class="btn btn-light btn-xs rounded-pill px-2 py-1 small border @(f.Preset == "this_quarter" ? "btn-primary text-white" : "")" onclick="applyPreset('this_quarter')">
                        Quý hiện tại
                    </button>
                    <button type="button" class="btn btn-light btn-xs rounded-pill px-2 py-1 small border @(f.Preset == "this_year" ? "btn-primary text-white" : "")" onclick="applyPreset('this_year')">
                        Cả năm 2026
                    </button>
                    <button type="button" class="btn btn-light btn-xs rounded-pill px-2 py-1 small border @(f.Preset == "my_dept" ? "btn-primary text-white" : "")" onclick="applyPreset('my_dept')">
                        Đơn vị của tôi
                    </button>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-link btn-xs text-secondary text-decoration-none p-0" id="btnSaveCurrentFilter">
                        <i class="bi bi-bookmark-plus me-1"></i>Lưu bộ lọc này
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- 4 EXECUTIVE SUMMARY CARDS -->
    <div class="row g-3 mb-4">
        <!-- 1. Đã đánh giá & Tỷ lệ -->
        <div class="col-md-3">
            <div class="card-enterprise p-3 h-100 border-start border-4 border-primary shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-secondary small text-uppercase fw-semibold">Tiến Độ Đánh Giá</span>
                    <span class="badge bg-primary-subtle text-primary font-mono">@s.CompletionRate%</span>
                </div>
                <div class="display-6 fw-bold font-mono text-primary my-1">
                    @s.EvaluatedEmployees <span class="fs-6 text-muted fw-normal">/ @s.TotalEmployees CB</span>
                </div>
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-primary" role="progressbar" style="width: @s.CompletionRate%"></div>
                </div>
            </div>
        </div>

        <!-- 2. Điểm TB & Độ lệch chuẩn -->
        <div class="col-md-3">
            <div class="card-enterprise p-3 h-100 border-start border-4 border-success shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-secondary small text-uppercase fw-semibold">Điểm KPI Trung Bình</span>
                    <span class="badge bg-success-subtle text-success font-mono">&sigma; = @s.StandardDeviation</span>
                </div>
                <div class="display-6 fw-bold font-mono text-success my-1">
                    @s.AverageScore.ToString("0.0") <span class="fs-6 text-muted fw-normal">/ 100 đ</span>
                </div>
                <div class="small text-muted">
                    Xếp loại chung: <strong class="text-dark">Hoàn thành tốt</strong>
                </div>
            </div>
        </div>

        <!-- 3. Cao nhất / Thấp nhất -->
        <div class="col-md-3">
            <div class="card-enterprise p-3 h-100 border-start border-4 border-warning shadow-sm">
                <div class="text-secondary small text-uppercase fw-semibold">Biên Độ Điểm Số</div>
                <div class="d-flex justify-content-between align-items-baseline my-1">
                    <div>
                        <span class="badge bg-success-subtle text-success">Max</span>
                        <strong class="font-mono fs-5 text-dark ms-1">@s.HighestScore.ToString("0.0")</strong>
                        <div class="text-muted small text-truncate" style="max-width: 110px;">@s.HighestEmployeeName</div>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-danger-subtle text-danger">Min</span>
                        <strong class="font-mono fs-5 text-dark ms-1">@s.LowestScore.ToString("0.0")</strong>
                        <div class="text-muted small text-truncate" style="max-width: 110px;">@s.LowestEmployeeName</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Tuân thủ Chuông Gauss -->
        <div class="col-md-3">
            <div class="card-enterprise p-3 h-100 border-start border-4 @(s.IsGaussCompliant ? "border-info" : "border-danger") shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-secondary small text-uppercase fw-semibold">Kiểm Định Gauss</span>
                    <span class="badge @(s.IsGaussCompliant ? "bg-info-subtle text-info" : "bg-danger-subtle text-danger") font-mono">
                        @(s.IsGaussCompliant ? "✅ ĐẠT CHUẨN" : "⚠️ LỆCH CHUẨN")
                    </span>
                </div>
                <div class="fw-bold fs-6 my-1 text-dark">
                    @s.ComplianceStatus
                </div>
                <div class="small text-muted text-truncate" title="@s.ComplianceMessage">
                    @s.ComplianceMessage
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN NAV TABS -->
    <ul class="nav nav-pills nav-pills-enterprise mb-4 no-print" id="reportTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link @(Model.CurrentTab == "overview" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tabOverview" onclick="setTab('overview')">
                <i class="bi bi-grid-fill me-2"></i>Tổng Quan Đa Chiều
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(Model.CurrentTab == "leaderboard" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tabLeaderboard" onclick="setTab('leaderboard')">
                <i class="bi bi-trophy-fill me-2 text-warning"></i>Bảng Xếp Hạng (Leaderboard)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(Model.CurrentTab == "gauss" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tabGauss" onclick="setTab('gauss')">
                <i class="bi bi-bell-fill me-2 text-info"></i>Chuông Gauss & Kiểm Soát Trần
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(Model.CurrentTab == "trends" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tabTrends" onclick="setTab('trends')">
                <i class="bi bi-graph-up me-2 text-success"></i>Xu Hướng & Heatmap
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(Model.CurrentTab == "dataviz" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tabDataViz" onclick="setTab('dataviz')">
                <i class="bi bi-pie-chart-fill me-2 text-danger"></i>Trực Quan Hóa (Outliers & Funnel)
            </button>
        </li>
    </ul>

    <!-- TAB CONTENTS -->
    <div class="tab-content" id="reportTabContent">

        <!-- ========================================== -->
        <!-- TAB 1: TỔNG QUAN ĐA CHIỀU (OVERVIEW)       -->
        <!-- ========================================== -->
        <div class="tab-pane fade @(Model.CurrentTab == "overview" ? "show active" : "")" id="tabOverview">
            <div class="row g-4 mb-4">
                <!-- TOP 3 PODIUM PREVIEW -->
                <div class="col-lg-5">
                    <div class="card-enterprise p-4 h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold text-dark mb-0">
                                <i class="bi bi-award-fill me-2 text-warning"></i>Vinh Danh Top 3 Hiệu Suất
                            </h5>
                            <a href="javascript:void(0)" onclick="setTab('leaderboard')" class="small text-primary text-decoration-none">Xem tất cả &rarr;</a>
                        </div>

                        <div class="podium-container d-flex justify-content-center align-items-end gap-3 pt-4 pb-2">
                            @{
                                var top1 = Model.Leaderboard.ElementAtOrDefault(0);
                                var top2 = Model.Leaderboard.ElementAtOrDefault(1);
                                var top3 = Model.Leaderboard.ElementAtOrDefault(2);
                            }

                            <!-- 2ND PLACE (SILVER) -->
                            @if (top2 != null)
                            {
                                <div class="podium-step podium-silver text-center">
                                    <div class="podium-avatar-wrapper mb-2">
                                        <div class="avatar-circle border-silver">@(top2.FullName.Substring(0, 1))</div>
                                        <span class="badge bg-silver text-dark podium-badge">2</span>
                                    </div>
                                    <div class="fw-bold small text-truncate text-dark" style="max-width: 100px;">@top2.FullName</div>
                                    <div class="font-mono fw-bold text-primary small">@top2.FinalScore.ToString("0.0") đ</div>
                                    <div class="podium-block bg-silver-block"></div>
                                </div>
                            }

                            <!-- 1ST PLACE (GOLD) -->
                            @if (top1 != null)
                            {
                                <div class="podium-step podium-gold text-center">
                                    <div class="crown-icon text-warning mb-1"><i class="bi bi-crown-fill fs-4"></i></div>
                                    <div class="podium-avatar-wrapper mb-2">
                                        <div class="avatar-circle border-gold">@(top1.FullName.Substring(0, 1))</div>
                                        <span class="badge bg-gold text-dark podium-badge">1</span>
                                    </div>
                                    <div class="fw-bold text-truncate text-dark" style="max-width: 120px;">@top1.FullName</div>
                                    <div class="font-mono fw-bold text-warning-dark fs-6">@top1.FinalScore.ToString("0.0") đ</div>
                                    <div class="podium-block bg-gold-block"></div>
                                </div>
                            }

                            <!-- 3RD PLACE (BRONZE) -->
                            @if (top3 != null)
                            {
                                <div class="podium-step podium-bronze text-center">
                                    <div class="podium-avatar-wrapper mb-2">
                                        <div class="avatar-circle border-bronze">@(top3.FullName.Substring(0, 1))</div>
                                        <span class="badge bg-bronze text-white podium-badge">3</span>
                                    </div>
                                    <div class="fw-bold small text-truncate text-dark" style="max-width: 100px;">@top3.FullName</div>
                                    <div class="font-mono fw-bold text-primary small">@top3.FinalScore.ToString("0.0") đ</div>
                                    <div class="podium-block bg-bronze-block"></div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- MINI BELL CURVE OVERLAY PREVIEW -->
                <div class="col-lg-7">
                    <div class="card-enterprise p-4 h-100">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <h5 class="fw-bold text-dark mb-0">
                                    <i class="bi bi-bell-fill me-2 text-info"></i>Phân Bổ Xếp Loại vs Chuẩn Gauss (15-70-10-5)
                                </h5>
                                <div class="text-muted small">So sánh thực tế cơ quan vs phân phối chuẩn hình chuông Gauss</div>
                            </div>
                            <span class="badge @(Model.Gauss.IsCompliant ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") font-mono">
                                @(Model.Gauss.IsCompliant ? "Hợp chuẩn" : "Lệch chuẩn")
                            </span>
                        </div>
                        <div id="chartMiniGauss" style="min-height: 280px;"></div>
                    </div>
                </div>
            </div>

            <!-- TREND & SUMMARY TABLE -->
            <div class="card-enterprise p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-graph-up me-2 text-primary"></i>Điểm KPI Trung Bình Qua Các Kỳ Đánh Giá
                    </h5>
                    <span class="badge bg-light text-secondary border font-mono">Học viện Hành chính</span>
                </div>
                <div id="chartOverviewTrend" style="min-height: 260px;"></div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB 2: BẢNG XẾP HẠNG HIỆU SUẤT (LEADERBOARD) -->
        <!-- ========================================== -->
        <div class="tab-pane fade @(Model.CurrentTab == "leaderboard" ? "show active" : "")" id="tabLeaderboard">
            <div class="card-enterprise p-4">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div>
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-trophy-fill me-2 text-warning"></i>Bảng Xếp Hạng Toàn Diện Cán Bộ & Giảng Viên
                        </h5>
                        <div class="text-muted small">Cập nhật theo điểm chuẩn hóa tổng hợp, hỗ trợ sắp xếp và hoạt họa xếp hạng</div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <select class="form-select form-select-sm" style="width: 180px;" onchange="changeSort(this.value)">
                            <option value="ScoreDesc" selected="@(f.SortBy == "ScoreDesc")">Điểm: Cao &rarr; Thấp</option>
                            <option value="ScoreAsc" selected="@(f.SortBy == "ScoreAsc")">Điểm: Thấp &rarr; Cao</option>
                            <option value="Department" selected="@(f.SortBy == "Department")">Theo Phòng ban</option>
                            <option value="Classification" selected="@(f.SortBy == "Classification")">Theo Xếp loại</option>
                        </select>
                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" id="btnShuffleAnimation" title="Kích hoạt hiệu ứng shuffle">
                            <i class="bi bi-shuffle me-1"></i>Hiệu ứng Rank
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="tblLeaderboard">
                        <thead class="table-light small text-uppercase">
                            <tr>
                                <th style="width: 60px;" class="text-center">Hạng</th>
                                <th style="width: 70px;" class="text-center">Xu hướng</th>
                                <th>Cán bộ / Giảng viên</th>
                                <th>Phòng ban / Đơn vị</th>
                                <th>Chức danh</th>
                                <th class="text-end" style="width: 100px;">Tự chấm</th>
                                <th class="text-end" style="width: 100px;">Thẩm định</th>
                                <th class="text-end" style="width: 110px;">Điểm KPI</th>
                                <th class="text-center" style="width: 160px;">Xếp loại</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Leaderboard)
                            {
                                <tr class="leaderboard-row @(item.Rank <= 3 ? "table-highlight-top" : "")" data-rank="@item.Rank">
                                    <td class="text-center font-mono">
                                        @if (item.Rank == 1)
                                        {
                                            <span class="badge-rank badge-rank-gold" title="Quán quân">🥇 1</span>
                                        }
                                        else if (item.Rank == 2)
                                        {
                                            <span class="badge-rank badge-rank-silver" title="Á quân">🥈 2</span>
                                        }
                                        else if (item.Rank == 3)
                                        {
                                            <span class="badge-rank badge-rank-bronze" title="Hạng ba">🥉 3</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fw-bold">#@item.Rank</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.TrendDirection == "Up")
                                        {
                                            <span class="text-success fw-bold" title="Tăng hạng">&uarr;</span>
                                        }
                                        else if (item.TrendDirection == "Down")
                                        {
                                            <span class="text-danger fw-bold" title="Giảm hạng">&darr;</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted" title="Giữ nguyên">&rarr;</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar-circle-sm">@(item.FullName.Substring(0, 1))</div>
                                            <div>
                                                <div class="fw-bold text-dark">@item.FullName</div>
                                                <div class="small text-muted font-mono" style="font-size: 11px;">@item.StaffCode</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@item.DepartmentName</td>
                                    <td class="text-secondary small">@item.PositionName</td>
                                    <td class="text-end font-mono text-muted">@item.SelfScore.ToString("0.0")</td>
                                    <td class="text-end font-mono text-muted">@item.ManagerScore.ToString("0.0")</td>
                                    <td class="text-end font-mono fw-bold fs-6 text-primary">@item.FinalScore.ToString("0.0")</td>
                                    <td class="text-center">
                                        <span class="badge @(item.FinalScore >= 90 ? "bg-warning text-dark" : (item.FinalScore >= 70 ? "bg-success" : (item.FinalScore >= 50 ? "bg-primary" : "bg-danger"))) rounded-pill px-2 py-1">
                                            @item.Classification
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB 3: CHUÔNG GAUSS & KIỂM SOÁT PHÂN BỔ   -->
        <!-- ========================================== -->
        <div class="tab-pane fade @(Model.CurrentTab == "gauss" ? "show active" : "")" id="tabGauss">
            <div class="row g-4 mb-4">
                <!-- CHART GAUSS INTERACTIVE OVERLAY -->
                <div class="col-lg-8">
                    <div class="card-enterprise p-4 h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h5 class="fw-bold text-dark mb-0">
                                    <i class="bi bi-bell-fill me-2 text-info"></i>Đồ Thị Phân Phối Chuẩn Gauss & Kiểm Soát Trần
                                </h5>
                                <div class="text-muted small">Đường cong lý tưởng &mu; = @Model.Gauss.Mean, &sigma; = @Model.Gauss.StdDev vs Phân bổ thực tế</div>
                            </div>
                            <span class="badge @(Model.Gauss.IsCompliant ? "bg-success" : "bg-danger") px-3 py-2 rounded-pill font-mono">
                                @(Model.Gauss.IsCompliant ? "✅ ĐẠT CHUẨN GAUSS" : "⚠️ LỆCH TRẦN 20%")
                            </span>
                        </div>
                        <div id="chartMainGauss" style="min-height: 380px;"></div>
                        <div class="small text-muted text-center mt-2">
                            <i class="bi bi-info-circle me-1 text-primary"></i>Nhấp chuột vào từng cột band để xem danh sách chi tiết cán bộ trong nhóm.
                        </div>
                    </div>
                </div>

                <!-- BẢNG BĂNG ĐIỂM (BANDS & COMPLIANCE) -->
                <div class="col-lg-4">
                    <div class="card-enterprise p-4 h-100">
                        <h5 class="fw-bold text-dark mb-3">
                            <i class="bi bi-layers-fill me-2 text-primary"></i>Phân Bổ Tỷ Lệ Theo 4 Khung
                        </h5>

                        <div class="d-flex flex-column gap-3">
                            @foreach (var band in Model.Gauss.Bands)
                            {
                                <div class="p-3 rounded-3 border @(band.IsCompliant ? "border-success-subtle bg-light" : "border-danger-subtle bg-danger-subtle") band-card" 
                                     style="cursor: pointer;" onclick="openDrillDown('@band.BandCode', '@band.BandName')">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold text-dark">@band.BandName</span>
                                        <span class="badge @(band.IsCompliant ? "bg-success" : "bg-danger") font-mono">
                                            @band.ActualPercentage%
                                        </span>
                                    </div>
                                    <div class="d-flex justify-content-between text-muted small mb-2">
                                        <span>Số lượng: <strong>@band.ActualCount CB</strong></span>
                                        <span>Chuẩn: <strong>@band.IdealPercentage%</strong></span>
                                    </div>
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar @(band.BandCode == "EXCELLENT" ? "bg-warning" : (band.BandCode == "GOOD" ? "bg-success" : (band.BandCode == "SATISFACTORY" ? "bg-primary" : "bg-danger")))" 
                                             role="progressbar" style="width: @band.ActualPercentage%"></div>
                                    </div>
                                    <div class="text-end small mt-1 font-mono @(band.IsCompliant ? "text-success" : "text-danger")" style="font-size: 11px;">
                                        @(band.Deviation >= 0 ? "+" : "")@band.Deviation% so với chuẩn
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB 4: PHÂN TÍCH XU HƯỚNG & HEATMAP MATRIX -->
        <!-- ========================================== -->
        <div class="tab-pane fade @(Model.CurrentTab == "trends" ? "show active" : "")" id="tabTrends">
            <div class="row g-4 mb-4">
                <!-- 1. TREND LINE CHART -->
                <div class="col-lg-6">
                    <div class="card-enterprise p-4 h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold text-dark mb-0">
                                <i class="bi bi-graph-up-arrow me-2 text-success"></i>Xu Hướng Điểm Trung Bình Qua Các Kỳ
                            </h5>
                            <span class="badge bg-light text-secondary border font-mono">Line Chart</span>
                        </div>
                        <div id="chartTrendPeriods" style="min-height: 340px;"></div>
                    </div>
                </div>

                <!-- 2. SO SÁNH PHÒNG BAN (KỲ TRƯỚC VS KỲ NÀY) -->
                <div class="col-lg-6">
                    <div class="card-enterprise p-4 h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold text-dark mb-0">
                                <i class="bi bi-arrow-left-right me-2 text-primary"></i>So Sánh Điểm Phòng Ban (Kỳ Trước vs Kỳ Này)
                            </h5>
                            <span class="badge bg-light text-secondary border font-mono">Biến Động</span>
                        </div>
                        <div id="chartDeptComparison" style="min-height: 340px;"></div>
                    </div>
                </div>
            </div>

            <!-- 3. MA TRẬN HEATMAP -->
            <div class="card-enterprise p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-grid-3x3-gap-fill me-2 text-warning"></i>Ma Trận Heatmap: Đơn Vị &times; Kỳ Đánh Giá
                        </h5>
                        <div class="text-muted small">Cường độ màu phản ánh mức độ hoàn thành chỉ tiêu KPI của từng phòng ban</div>
                    </div>
                    <div class="d-flex align-items-center gap-2 small">
                        <span class="badge" style="background: #ef4444;">&lt;60</span>
                        <span class="badge" style="background: #f59e0b;">60-74</span>
                        <span class="badge" style="background: #3b82f6;">75-89</span>
                        <span class="badge" style="background: #10b981;">&gt;=90</span>
                    </div>
                </div>
                <div id="chartHeatmapMatrix" style="min-height: 360px;"></div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB 5: TRỰC QUAN HÓA MỞ RỘNG (DATAVIZ)    -->
        <!-- ========================================== -->
        <div class="tab-pane fade @(Model.CurrentTab == "dataviz" ? "show active" : "")" id="tabDataViz">
            <div class="row g-4 mb-4">
                <!-- 1. SCATTER PLOT (TỰ CHẤM VS QUẢN LÝ - OUTLIERS) -->
                <div class="col-lg-7">
                    <div class="card-enterprise p-4 h-100">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <h5 class="fw-bold text-dark mb-0">
                                    <i class="bi bi-bullseye me-2 text-danger"></i>Phân Tán Điểm: Tự Chấm vs Quản Lý Thẩm Định
                                </h5>
                                <div class="text-muted small">Phát hiện sớm điểm bất thường hoặc lệch pha (&ge; 15 điểm) giữa 2 cấp</div>
                            </div>
                            <span class="badge bg-danger-subtle text-danger font-mono">Scatter Outliers</span>
                        </div>
                        <div id="chartScatterPlot" style="min-height: 360px;"></div>
                    </div>
                </div>

                <!-- 2. FUNNEL CHART (QUY TRÌNH ĐÁNH GIÁ 5 GIAI ĐOẠN) -->
                <div class="col-lg-5">
                    <div class="card-enterprise p-4 h-100">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <h5 class="fw-bold text-dark mb-0">
                                    <i class="bi bi-funnel-fill me-2 text-primary"></i>Phễu Quy Trình Đánh Giá
                                </h5>
                                <div class="text-muted small">Tiến độ chuyển đổi qua 5 bước thực hiện</div>
                            </div>
                            <span class="badge bg-primary-subtle text-primary font-mono">Funnel Chart</span>
                        </div>
                        <div id="chartFunnel" style="min-height: 360px;"></div>
                    </div>
                </div>
            </div>

            <!-- 3. BOX & WHISKER PLOT (PHÂN BỔ ĐIỂM THEO PHÒNG BAN) -->
            <div class="card-enterprise p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-bar-chart-steps me-2 text-info"></i>Phân Bố Hộp (Box &amp; Whisker) Theo Phòng Ban
                        </h5>
                        <div class="text-muted small">Thống kê Min, Tứ phân vị Q1, Trung vị Median, Tứ phân vị Q3, Max</div>
                    </div>
                    <span class="badge bg-info-subtle text-info font-mono">BoxPlot</span>
                </div>
                <div id="chartBoxPlot" style="min-height: 360px;"></div>
            </div>
        </div>

    </div>
</div>

<!-- ========================================== -->
<!-- MODAL 1: DRILL-DOWN CHI TIẾT THEO BAND    -->
<!-- ========================================== -->
<div class="modal fade" id="modalDrillDown" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white border-0 rounded-top-4">
                <h5 class="modal-title fw-bold" id="drillDownTitle">
                    <i class="bi bi-people-fill me-2"></i>Danh Sách Cán Bộ Trong Băng Điểm
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle small mb-0" id="tblDrillDown">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Mã CB</th>
                                <th>Họ và tên</th>
                                <th>Phòng ban</th>
                                <th class="text-end">Điểm KPI</th>
                                <th>Xếp loại</th>
                            </tr>
                        </thead>
                        <tbody id="drillDownBody">
                            <!-- Populated via JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-0 p-3 bg-light rounded-bottom-4">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL 2: ĐẶT LỊCH GỬI EMAIL BÁO CÁO       -->
<!-- ========================================== -->
<div class="modal fade" id="modalScheduleReport" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-dark text-white border-0 rounded-top-4">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-clock-history me-2 text-warning"></i>Đặt Lịch Gửi Email Báo Cáo Tự Động
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Kỳ đánh giá:</label>
                    <input type="text" class="form-control" value="@Model.Periods.FirstOrDefault(p => p.Id == f.PeriodId)?.Name" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Tần suất gửi:</label>
                    <select class="form-select" id="txtScheduleFreq">
                        <option value="End_Of_Period" selected>Cuối kỳ đánh giá (Tự động khi đóng sổ)</option>
                        <option value="Weekly">Hàng tuần (Thứ Hai, 08:00 AM)</option>
                        <option value="Monthly">Hàng tháng (Ngày 01 đầu tháng)</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Định dạng đính kèm:</label>
                    <select class="form-select" id="txtScheduleFormat">
                        <option value="Excel" selected>Microsoft Excel (.xlsx)</option>
                        <option value="PDF">Tài liệu PDF (.pdf)</option>
                        <option value="CSV">Dữ liệu thô CSV (.csv)</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Danh sách email nhận (phân cách dấu phẩy):</label>
                    <textarea class="form-control" id="txtScheduleEmails" rows="2" placeholder="director@napa.edu.vn, hr@napa.edu.vn">director@napa.edu.vn, ketoan@napa.edu.vn</textarea>
                </div>
            </div>
            <div class="modal-footer border-0 p-3 bg-light rounded-bottom-4">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" id="btnConfirmSchedule">
                    <i class="bi bi-send-check me-1"></i>Lưu Lịch Gửi
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .podium-container {
        height: 230px;
    }
    .podium-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
    }
    .podium-avatar-wrapper {
        position: relative;
    }
    .avatar-circle {
        width: 54px;
        height: 54px;
        border-radius: 50%;
        background: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 20px;
        color: #1e293b;
    }
    .avatar-circle-sm {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 13px;
        color: #1e293b;
    }
    .border-gold { border: 3px solid #f59e0b; box-shadow: 0 0 12px rgba(245, 158, 11, 0.4); }
    .border-silver { border: 3px solid #94a3b8; }
    .border-bronze { border: 3px solid #d97706; }
    .podium-badge {
        position: absolute;
        bottom: -5px;
        right: -5px;
        border-radius: 50%;
        width: 22px;
        height: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 11px;
    }
    .bg-gold { background: #f59e0b; }
    .bg-silver { background: #94a3b8; }
    .bg-bronze { background: #d97706; }
    .bg-gold-block { height: 90px; width: 95px; background: linear-gradient(180deg, #fef3c7 0%, #fde68a 100%); border-radius: 8px 8px 0 0; }
    .bg-silver-block { height: 65px; width: 85px; background: linear-gradient(180deg, #f1f5f9 0%, #e2e8f0 100%); border-radius: 8px 8px 0 0; }
    .bg-bronze-block { height: 45px; width: 85px; background: linear-gradient(180deg, #ffedd5 0%, #fed7aa 100%); border-radius: 8px 8px 0 0; }
    .badge-rank {
        display: inline-block;
        padding: 3px 8px;
        border-radius: 9999px;
        font-weight: bold;
        font-size: 12px;
    }
    .badge-rank-gold { background: #fef3c7; color: #b45309; border: 1px solid #fcd34d; }
    .badge-rank-silver { background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }
    .badge-rank-bronze { background: #ffedd5; color: #c2410c; border: 1px solid #fdba74; }
    .table-highlight-top {
        background-color: rgba(254, 243, 199, 0.25) !important;
    }
</style>

<!-- SCRIPTS: APEXCHARTS & REPORT JS -->
<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
<script>
    window.reportData = {
        periodId: @f.PeriodId,
        gauss: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Gauss)),
        trends: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Trends)),
        dataViz: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DataViz))
    };
</script>
<script src="~/js/report-analytics.js" asp-append-version="true"></script>
