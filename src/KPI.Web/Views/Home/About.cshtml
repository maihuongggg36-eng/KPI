@{
    ViewData["Title"] = "Giới Thiệu Hệ Thống KPI - Học viện Hành chính và Quản trị công";
    ViewData["MetaDescription"] = "Hệ thống quản lý, giao chỉ tiêu, đánh giá hiệu suất (KPI) và phân loại cán bộ công chức theo Nghị định 90 của Học viện Hành chính và Quản trị công.";
}

<article class="container py-4">
    <header class="text-center py-4 mb-4 border-bottom">
        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-semibold mb-2">Học Viện Hành Chính Và Quản Trị Công</span>
        <h1 class="display-6 fw-bold text-dark">Hệ Thống Đánh Giá & Quản Trị Hiệu Quả Công Việc (KPI)</h1>
        <p class="lead text-muted mx-auto" style="max-width: 800px;">
            Nền tảng số hóa toàn diện quy trình giao chỉ tiêu, tự chấm điểm, thẩm định đa cấp, phân loại công chức theo Nghị định 90/2020/NĐ-CP & Nghị định 48/2023/NĐ-CP, gắn kết cùng quỹ thu nhập tăng thêm (Lương 3P).
        </p>
    </header>

    <div class="row g-4 mb-5">
        <section class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-3">
                <div class="card-body p-4 text-center">
                    <div class="rounded-circle bg-primary-subtle text-primary p-3 d-inline-flex mb-3">
                        <i class="bi bi-award fs-2"></i>
                    </div>
                    <h2 class="h5 fw-bold text-dark">Chuẩn Hóa Nghị Định 90 & 48</h2>
                    <p class="text-muted small mb-0">
                        Kiểm soát nghiêm ngặt tỷ lệ Hoàn thành xuất sắc nhiệm vụ không vượt quá trần 20% tổng số cán bộ, công chức, viên chức được xếp loại hoàn thành tốt nhiệm vụ theo BR-06.
                    </p>
                </div>
            </div>
        </section>

        <section class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-3">
                <div class="card-body p-4 text-center">
                    <div class="rounded-circle bg-success-subtle text-success p-3 d-inline-flex mb-3">
                        <i class="bi bi-cash-coin fs-2"></i>
                    </div>
                    <h2 class="h5 fw-bold text-dark">Gắn Kết Lương 3P (P1, P2, P3)</h2>
                    <p class="text-muted small mb-0">
                        Hệ thống tự động liên thông kết quả đánh giá KPI sang quỹ thu nhập tăng thêm (P3) với hệ số xếp loại từ 0.7 đến 1.3 và in phiếu chi tiền mặt chuẩn Mẫu 02-TT.
                    </p>
                </div>
            </div>
        </section>

        <section class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-3">
                <div class="card-body p-4 text-center">
                    <div class="rounded-circle bg-info-subtle text-info p-3 d-inline-flex mb-3">
                        <i class="bi bi-graph-up-arrow fs-2"></i>
                    </div>
                    <h2 class="h5 fw-bold text-dark">Phân Tích Dữ Liệu & Chuông Gauss</h2>
                    <p class="text-muted small mb-0">
                        Biểu đồ phân phối chuẩn Gauss trực quan, kiểm soát độ lệch chuẩn và độ nhọn (Kurtosis), bảng vinh danh Leaderboard Top 3 cá nhân và đơn vị xuất sắc.
                    </p>
                </div>
            </div>
        </section>
    </div>

    <section class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-primary text-white mb-4">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h2 class="h3 fw-bold mb-2">Trải Nghiệm Nền Tảng Ngay Hôm Nay</h2>
                <p class="mb-0 text-white-50">Truy cập Bảng điều khiển để theo dõi các chỉ tiêu KPI, tiến độ thẩm định và xếp loại của đơn vị.</p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <a href="/Dashboard" class="btn btn-light btn-lg px-4 shadow-sm fw-semibold">
                    <i class="bi bi-speedometer2 me-1"></i> Bảng Điều Khiển
                </a>
            </div>
        </div>
    </section>
</article>
