@{
    ViewData["Title"] = "Bàn làm việc Chỉ huy";
    var dbConnected = (bool)(ViewBag.DbCanConnect ?? false);
    var userCount = (int)(ViewBag.UserCount ?? 6);
    var roleCount = (int)(ViewBag.RoleCount ?? 6);
    var deptCount = (int)(ViewBag.DeptCount ?? 5);
    var kpiItemCount = (int)(ViewBag.KpiItemCount ?? 4);

    ViewData["BreadcrumbItems"] = new List<(string Title, string Url)>
    {
        ("Bàn làm việc", "/Home/Index")
    };
}

<!-- Welcome Banner -->
<div class="card-enterprise p-4 mb-4" style="background: linear-gradient(135deg, rgba(37, 99, 235, 0.1) 0%, rgba(99, 102, 241, 0.1) 100%); border-left: 4px solid var(--color-primary);">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <div class="d-flex align-items-center gap-2 mb-2">
                <partial name="Partials/_Badge" view-data='@new ViewDataDictionary(ViewData) { ["Variant"] = "primary", ["Text"] = "Clean Architecture .NET 8 LTS", ["HasDot"] = true }' />
                <partial name="Partials/_Badge" view-data='@new ViewDataDictionary(ViewData) { ["Variant"] = (dbConnected ? "success" : "warning"), ["Text"] = (dbConnected ? "SQL Server: Đã kết nối" : "SQL Server: Ngoại tuyến"), ["HasDot"] = true }' />
            </div>
            <h2 class="fw-bold mb-1 text-primary-emphasis">Học viện Hành chính và Quản trị công</h2>
            <p class="text-secondary small mb-0">
                Bàn làm việc điều hành Đánh giá Hiệu suất (BSC/KPI/OKRs) kết hợp khung phân loại Cán bộ Công chức theo <strong>Nghị định 90/2020/NĐ-CP</strong> và <strong>Nghị định 48/2023/NĐ-CP</strong>.
            </p>
        </div>
        <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
            <a asp-controller="Auth" asp-action="Login" class="btn btn-primary px-3 py-2 rounded-pill fw-semibold btn-lift">
                <i class="bi bi-arrow-repeat me-1"></i> Chuyển đổi Vai trò 1-Click
            </a>
        </div>
    </div>
</div>

<!-- 4 Thẻ Thống kê Chỉ số StatCards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <partial name="Partials/_StatCard" view-data='@new ViewDataDictionary(ViewData) { 
            ["Title"] = "Tổng Nhân sự / Cán bộ", 
            ["Value"] = userCount.ToString(), 
            ["Subtitle"] = "100% đã định danh điện tử", 
            ["Icon"] = "bi-people-fill", 
            ["Color"] = "primary",
            ["Trend"] = "+2 nhân sự",
            ["TrendPositive"] = true
        }' />
    </div>

    <div class="col-sm-6 col-xl-3">
        <partial name="Partials/_StatCard" view-data='@new ViewDataDictionary(ViewData) { 
            ["Title"] = "Đơn vị / Phòng ban", 
            ["Value"] = deptCount.ToString(), 
            ["Subtitle"] = "Phân cấp hình cây (Closure Table)", 
            ["Icon"] = "bi-diagram-3-fill", 
            ["Color"] = "info",
            ["Trend"] = "5 đơn vị",
            ["TrendPositive"] = true
        }' />
    </div>

    <div class="col-sm-6 col-xl-3">
        <partial name="Partials/_StatCard" view-data='@new ViewDataDictionary(ViewData) { 
            ["Title"] = "Ngân hàng Chỉ tiêu KPI", 
            ["Value"] = kpiItemCount.ToString(), 
            ["Subtitle"] = "Chỉ số chuẩn hóa theo 4 viễn cảnh", 
            ["Icon"] = "bi-journal-bookmark-fill", 
            ["Color"] = "warning",
            ["Trend"] = "Đạt chuẩn BSC",
            ["TrendPositive"] = true
        }' />
    </div>

    <div class="col-sm-6 col-xl-3">
        <partial name="Partials/_StatCard" view-data='@new ViewDataDictionary(ViewData) { 
            ["Title"] = "Trần Khống chế Xuất sắc", 
            ["Value"] = "≤ 20%", 
            ["Subtitle"] = "Tuân thủ nghiêm ngặt Nghị định 90", 
            ["Icon"] = "bi-shield-check", 
            ["Color"] = "success",
            ["Trend"] = "BR-06 Passed",
            ["TrendPositive"] = true
        }' />
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Bảng 6 Tài khoản Thử nghiệm chuẩn -->
    <div class="col-lg-8">
        <div class="card-enterprise">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-person-badge-fill text-primary fs-5"></i>
                    <h5 class="fw-bold mb-0">6 Tài khoản Thử nghiệm (Mật khẩu: <code>123456</code>)</h5>
                </div>
                <span class="badge bg-secondary-subtle text-secondary small">Seed Data</span>
            </div>
            <div class="table-responsive">
                <table class="table-enterprise">
                    <thead>
                        <tr>
                            <th>Tài khoản</th>
                            <th>Họ và Tên</th>
                            <th>Vai trò & Quyền hạn</th>
                            <th>Thẩm quyền Data Scope</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span class="badge bg-dark font-mono">director</span></td>
                            <td class="fw-bold">Trần Lãnh Đạo</td>
                            <td><span class="badge bg-danger-subtle text-danger">Giám đốc Học viện</span></td>
                            <td><span class="badge bg-primary-subtle text-primary">Toàn Học viện (Organization)</span></td>
                        </tr>
                        <tr>
                            <td><span class="badge bg-dark font-mono">manager</span></td>
                            <td class="fw-bold">Lê Trưởng Phòng</td>
                            <td><span class="badge bg-primary-subtle text-primary">Trưởng phòng Đào tạo</span></td>
                            <td><span class="badge bg-info-subtle text-info">Phòng Đào tạo (Department)</span></td>
                        </tr>
                        <tr>
                            <td><span class="badge bg-dark font-mono">officer1</span></td>
                            <td class="fw-bold">Nguyễn Chuyên Viên</td>
                            <td><span class="badge bg-success-subtle text-success">Chuyên viên Quản lý ĐT</span></td>
                            <td><span class="badge bg-secondary-subtle text-secondary">Cá nhân (Self)</span></td>
                        </tr>
                        <tr>
                            <td><span class="badge bg-dark font-mono">hr_admin</span></td>
                            <td class="fw-bold">Vũ Thị Nhân Sự</td>
                            <td><span class="badge bg-info-subtle text-info">Cán bộ TCCB (HR)</span></td>
                            <td><span class="badge bg-primary-subtle text-primary">Toàn Học viện (Organization)</span></td>
                        </tr>
                        <tr>
                            <td><span class="badge bg-dark font-mono">accountant</span></td>
                            <td class="fw-bold">Hoàng Kế Toán</td>
                            <td><span class="badge bg-warning-subtle text-warning">Kế toán viên Lương</span></td>
                            <td><span class="badge bg-primary-subtle text-primary">Toàn Học viện (Organization)</span></td>
                        </tr>
                        <tr>
                            <td><span class="badge bg-dark font-mono">admin</span></td>
                            <td class="fw-bold">Quản trị viên Hệ thống</td>
                            <td><span class="badge bg-secondary-subtle text-secondary">System Administrator</span></td>
                            <td><span class="badge bg-primary-subtle text-primary">Toàn quyền Hệ thống</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Quy tắc Nghiệp vụ đã Kiểm thử -->
    <div class="col-lg-4">
        <div class="card-enterprise h-100">
            <div class="p-3 border-bottom d-flex align-items-center gap-2">
                <i class="bi bi-shield-check text-success fs-5"></i>
                <h5 class="fw-bold mb-0">Quy tắc Nghiệp vụ (Business Rules)</h5>
            </div>
            <div class="p-3">
                <ul class="list-unstyled mb-0 d-flex flex-direction-column gap-2">
                    <li class="d-flex justify-content-between align-items-center p-2 rounded-2 bg-surface-hover small">
                        <div><strong>BR-01</strong>: Tổng trọng số = 100%</div>
                        <span class="badge bg-success-subtle text-success">Passed</span>
                    </li>
                    <li class="d-flex justify-content-between align-items-center p-2 rounded-2 bg-surface-hover small">
                        <div><strong>BR-02</strong>: Biên độ trọng số [5%, 50%]</div>
                        <span class="badge bg-success-subtle text-success">Passed</span>
                    </li>
                    <li class="d-flex justify-content-between align-items-center p-2 rounded-2 bg-surface-hover small">
                        <div><strong>BR-05</strong>: Lệch điểm &gt; 10% bắt buộc giải trình</div>
                        <span class="badge bg-success-subtle text-success">Passed</span>
                    </li>
                    <li class="d-flex justify-content-between align-items-center p-2 rounded-2 bg-surface-hover small">
                        <div><strong>BR-06</strong>: Khống chế Xuất sắc &le; 20% Tốt</div>
                        <span class="badge bg-success-subtle text-success">Passed</span>
                    </li>
                    <li class="d-flex justify-content-between align-items-center p-2 rounded-2 bg-surface-hover small">
                        <div><strong>BR-07</strong>: Điểm liệt kỷ luật</div>
                        <span class="badge bg-success-subtle text-success">Passed</span>
                    </li>
                    <li class="d-flex justify-content-between align-items-center p-2 rounded-2 bg-surface-hover small">
                        <div><strong>BR-08</strong>: Sáng kiến bắt buộc cho Xuất sắc</div>
                        <span class="badge bg-success-subtle text-success">Passed</span>
                    </li>
                    <li class="d-flex justify-content-between align-items-center p-2 rounded-2 bg-surface-hover small">
                        <div><strong>BR-10</strong>: Chặn trần MaxCap 150%</div>
                        <span class="badge bg-success-subtle text-success">Passed</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
