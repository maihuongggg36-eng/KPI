</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Password strength meter
        const passInput = document.getElementById("inputNewPassword");
        const bar = document.getElementById("passwordStrengthBar");
        const text = document.getElementById("passwordStrengthText");

        if (passInput && bar && text) {
            passInput.addEventListener("input", function () {
                const val = passInput.value;
                let score = 0;
                if (val.length >= 6) score += 25;
                if (/[A-Z]/.test(val)) score += 25;
                if (/[0-9]/.test(val)) score += 25;
                if (/[^A-Za-z0-9]/.test(val)) score += 25;

                bar.style.width = score + "%";
                if (score <= 25) {
                    bar.className = "progress-bar bg-danger";
                    text.textContent = "Độ mạnh: Rất yếu";
                } else if (score <= 50) {
                    bar.className = "progress-bar bg-warning";
                    text.textContent = "Độ mạnh: Trung bình";
                } else if (score <= 75) {
                    bar.className = "progress-bar bg-info";
                    text.textContent = "Độ mạnh: Khá";
                } else {
                    bar.className = "progress-bar bg-success";
                    text.textContent = "Độ mạnh: Rất mạnh (Tốt)";
                }
            });
        }
    });
</script>
}
