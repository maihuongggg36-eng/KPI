@model KPI.Web.ViewModels.Evaluation.DirectorEvaluationListViewModel
@{
    ViewData["Title"] = "Phê Duyệt Đánh Giá KPI — Lãnh Đạo Viện";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var periods = ViewBag.Periods as List<KPI.Application.DTOs.EvaluationPeriodDetailDto> ?? new();
    var depts = ViewBag.Departments as List<KPI.Application.DTOs.DepartmentTreeNodeDto> ?? new();
}

<div class="content-body pb-5">
    <!-- PAGE HEADER -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb breadcrumb-dark mb-1">
                    <li class="breadcrumb-item"><a href="/Dashboard">Trang chủ</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Phê Duyệt KPI</li>
                </ol>
            </nav>
            <h1 class="page-title text-gradient-primary mb-1">
                <i class="bi bi-award-fill me-2 text-primary"></i>Phê Duyệt Kết Quả Đánh Giá (Director Approval)
            </h1>
            <p class="text-secondary small mb-0">Thẩm tra kết quả tổng hợp, Gap Analysis, xếp loại công chức Nghị định 90 và phê chuẩn kết quả cuối cùng (BR-15)</p>
        </div>
    </div>

    <!-- STATS SUMMARY CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card-enterprise p-3 border-start border-4 border-warning">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-secondary small text-uppercase">Chờ Lãnh Đạo Phê Duyệt</div>
                        <div class="display-6 fw-bold font-mono text-warning">@Model.PendingCount</div>
                    </div>
                    <div class="bg-warning-subtle text-warning p-3 rounded-circle">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card-enterprise p-3 border-start border-4 border-success">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-secondary small text-uppercase">Đã Phê Chuẩn & Khóa (BR-15)</div>
                        <div class="display-6 fw-bold font-mono text-success">@Model.ApprovedCount</div>
                    </div>
                    <div class="bg-success-subtle text-success p-3 rounded-circle">
                        <i class="bi bi-lock-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card-enterprise p-3 border-start border-4 border-danger">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-secondary small text-uppercase">Đơn Khiếu Nại (72h - BR-14)</div>
                        <div class="display-6 fw-bold font-mono text-danger">@Model.DisputedCount</div>
                    </div>
                    <div class="bg-danger-subtle text-danger p-3 rounded-circle">
                        <i class="bi bi-shield-exclamation fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FILTER BAR -->
    <div class="card-enterprise p-3 mb-4">
        <form method="get" action="/Evaluation/DirectorList" class="row g-2 align-items-center">
            <div class="col-md-4">
                <label class="form-label small text-secondary mb-1">Kỳ đánh giá:</label>
                <select name="periodId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Tất cả các kỳ --</option>
                    @foreach (var p in periods)
                    {
                        <option value="@p.Id" selected="@(p.Id == Model.SelectedPeriodId)">@p.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label small text-secondary mb-1">Phòng ban:</label>
                <select name="departmentId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Tất cả phòng ban --</option>
                    @foreach (var d in depts)
                    {
                        <option value="@d.Id" selected="@(d.Id == Model.SelectedDepartmentId)">@d.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-4 d-flex align-items-end gap-2">
                <a href="/Evaluation/DirectorList" class="btn btn-outline-secondary btn-sm rounded-pill flex-grow-1">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Đặt lại
                </a>
                <a href="/Evaluation/Disputes" class="btn btn-outline-danger btn-sm rounded-pill">
                    <i class="bi bi-shield-shaded me-1"></i>Đơn Khiếu Nại
                </a>
            </div>
        </form>
    </div>

    <!-- EVALUATION APPROVAL TABLE -->
    <div class="card-enterprise p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th style="width: 50px;" class="text-center">#</th>
                        <th>Cán bộ / Giảng viên</th>
                        <th>Phòng ban</th>
                        <th class="text-center">Tự Chấm</th>
                        <th class="text-center">Quản Lý Chấm</th>
                        <th class="text-center">Độ Lệch (Gap)</th>
                        <th class="text-center">Xếp loại</th>
                        <th class="text-center">Trạng thái</th>
                        <th style="width: 130px;" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Evaluations.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Không có hồ sơ nào trình Lãnh đạo trong danh sách.
                            </td>
                        </tr>
                    }
                    else
                    {
                        for (int i = 0; i < Model.Evaluations.Count; i++)
                        {
                            var item = Model.Evaluations[i];
                            var gap = Math.Abs(item.SelfTotalScore - item.ManagerTotalScore);
                            var isApproved = item.Status == KPI.Domain.Enums.EvaluationStatus.Final_Approved || item.Status == KPI.Domain.Enums.EvaluationStatus.Locked;

                            <tr>
                                <td class="text-center font-mono text-muted">@(i + 1)</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@item.AvatarUrl" alt="" class="rounded-circle border" style="width: 36px; height: 36px; object-fit: cover;">
                                        <div>
                                            <div class="fw-bold text-dark">@item.EmployeeName</div>
                                            <div class="font-mono text-muted small">@item.EmployeeCode</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="small text-secondary">@item.DepartmentName</td>
                                <td class="text-center font-mono text-primary fw-bold">@item.SelfTotalScore.ToString("F1")</td>
                                <td class="text-center font-mono text-success fw-bold">@item.ManagerTotalScore.ToString("F1")</td>
                                <td class="text-center font-mono @(gap > 10 ? "text-danger fw-bold" : "text-muted")">
                                    @gap.ToString("F1")
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark font-mono">
                                        @(string.IsNullOrEmpty(item.FinalClassification) ? "Chưa xếp loại" : item.FinalClassification)
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge @item.StatusBadgeClass rounded-pill px-2 py-1 small">
                                        @item.StatusName
                                    </span>
                                    @if (item.IsDisputed)
                                    {
                                        <div class="badge bg-danger text-white rounded-pill px-2 py-0 mt-1" style="font-size: 10px;">
                                            Đang khiếu nại
                                        </div>
                                    }
                                </td>
                                <td class="text-center">
                                    <a href="/Evaluation/DirectorReview?evaluationId=@item.Id" class="btn @(isApproved ? "btn-light text-secondary" : "btn-primary") btn-sm rounded-pill px-3 shadow-sm">
                                        <i class="bi @(isApproved ? "bi-eye" : "bi-check2-circle") me-1"></i>@(isApproved ? "Xem" : "Phê Duyệt")
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
