@model ErrorViewModel
@{
    Layout = null;
    ViewData["Title"] = Model.ErrorTitle;
    var iconClass = Model.StatusCode switch
    {
        404 => "bi-compass text-warning",
        403 => "bi-shield-lock-fill text-danger",
        401 => "bi-key-fill text-info",
        _ => "bi-exclamation-octagon-fill text-danger"
    };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.ErrorTitle - Học viện Hành chính và Quản trị công</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="bg-light">

<div class="container py-5 my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7 text-center">
            <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-body">
                <div class="card-body">
                    <div class="mb-4">
                        <i class="bi @iconClass display-1"></i>
                    </div>

                    <h1 class="h2 fw-bold text-dark mb-2">@Model.ErrorTitle</h1>
                    <p class="text-muted fs-6 mb-4">@Model.ErrorDescription</p>

                    @if (Model.ShowRequestId)
                    {
                        <div class="alert alert-light border small font-monospace d-inline-block px-3 py-2 text-muted mb-4">
                            <i class="bi bi-tag-fill me-1"></i> Mã theo dõi sự cố (Trace ID): <strong>@Model.RequestId</strong>
                        </div>
                    }

                    <div class="d-flex flex-wrap justify-content-center gap-2 mt-2">
                        <a href="/Dashboard" class="btn btn-primary px-4 py-2 shadow-sm rounded-pill">
                            <i class="bi bi-speedometer2 me-1"></i> Bảng điều khiển
                        </a>
                        <button onclick="window.history.back()" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại trang trước
                        </button>
                        <a href="/Health" class="btn btn-outline-info px-4 py-2 rounded-pill">
                            <i class="bi bi-heart-pulse me-1"></i> Kiểm tra hệ thống
                        </a>
                        <a href="/Home/UserGuide" class="btn btn-link text-decoration-none px-3 py-2 text-muted">
                            <i class="bi bi-question-circle me-1"></i> Hướng dẫn sử dụng
                        </a>
                    </div>
                </div>
            </div>

            <p class="text-muted small mt-4 mb-0">
                Nếu sự cố tiếp tục xảy ra, vui lòng liên hệ Ban Công nghệ Thông tin - Học viện Hành chính và Quản trị công.
            </p>
        </div>
    </div>
</div>
</body>
</html>
