@* 
    _StatCard.cshtml
    Tham số ViewData:
    - Title: Tên chỉ số (string)
    - Value: Giá trị hiển thị (string)
    - Subtitle: Diễn giải thêm (string)
    - Icon: Bootstrap Icon class (vd: bi-graph-up-arrow)
    - Color: primary | success | warning | danger | info | accent
    - Trend: +12.5% | -3.2% (string)
    - TrendPositive: true | false (bool)
*@
@{
    var title = ViewData["Title"]?.ToString() ?? "Chỉ số";
    var val = ViewData["Value"]?.ToString() ?? "0";
    var subtitle = ViewData["Subtitle"]?.ToString() ?? "";
    var icon = ViewData["Icon"]?.ToString() ?? "bi-bar-chart-fill";
    var color = ViewData["Color"]?.ToString() ?? "primary";
    var trend = ViewData["Trend"]?.ToString();
    var isTrendPos = (bool)(ViewData["TrendPositive"] ?? true);

    var colorMap = color switch
    {
        "success" => "text-success bg-success-subtle",
        "warning" => "text-warning bg-warning-subtle",
        "danger" => "text-danger bg-danger-subtle",
        "info" => "text-info bg-info-subtle",
        "accent" => "text-primary bg-primary-subtle",
        _ => "text-primary bg-primary-subtle"
    };
}

<div class="stat-card">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <span class="text-secondary small fw-semibold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px;">@title</span>
            <h3 class="fw-bold my-1 font-mono" style="letter-spacing: -0.5px;">@val</h3>
        </div>
        <div class="stat-icon-wrapper @colorMap">
            <i class="bi @icon"></i>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-2 small">
        <span class="text-muted" style="font-size: 12px;">@subtitle</span>
        @if (!string.IsNullOrEmpty(trend))
        {
            <span class="badge @(isTrendPos ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") font-mono px-2 py-1">
                <i class="bi @(isTrendPos ? "bi-arrow-up-short" : "bi-arrow-down-short")"></i>@trend
            </span>
        }
    </div>
</div>
