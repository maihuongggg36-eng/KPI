@* 
    _EmptyState.cshtml
    Tham số ViewData:
    - Title: Tiêu đề trạng thái trống (string)
    - Description: Mô tả hướng dẫn người dùng (string)
    - Icon: Bootstrap Icon class (vd: bi-inbox)
    - ActionText: Tên nút hành động (string)
    - ActionUrl: Đường dẫn hành động (string)
*@
@{
    var title = ViewData["Title"]?.ToString() ?? "Chưa có dữ liệu";
    var desc = ViewData["Description"]?.ToString() ?? "Hiện chưa có bản ghi nào được ghi nhận trong danh mục này.";
    var icon = ViewData["Icon"]?.ToString() ?? "bi-folder2-open";
    var actionText = ViewData["ActionText"]?.ToString();
    var actionUrl = ViewData["ActionUrl"]?.ToString();
}

<div class="text-center py-5 px-3 my-4">
    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-surface-hover text-muted mb-3" style="width: 72px; height: 72px; border: 1px dashed var(--border-color);">
        <i class="bi @icon fs-2"></i>
    </div>
    <h5 class="fw-bold text-primary-emphasis mb-1">@title</h5>
    <p class="text-muted small mx-auto mb-3" style="max-width: 420px;">@desc</p>
    @if (!string.IsNullOrEmpty(actionText) && !string.IsNullOrEmpty(actionUrl))
    {
        <a href="@actionUrl" class="btn btn-primary btn-sm px-3 rounded-pill btn-lift">
            <i class="bi bi-plus-lg me-1"></i> @actionText
        </a>
    }
</div>
