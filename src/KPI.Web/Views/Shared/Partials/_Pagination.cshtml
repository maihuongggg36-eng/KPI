@* 
    _Pagination.cshtml
    Tham số ViewData:
    - CurrentPage: int
    - TotalPages: int
    - ActionName: string (vd: Index)
*@
@{
    var currentPage = ViewData["CurrentPage"] is int cp ? cp : 1;
    var totalPages = ViewData["TotalPages"] is int tp ? tp : 1;
    var action = ViewData["ActionName"]?.ToString() ?? "Index";
}

@if (totalPages > 1)
{
    <nav class="d-flex justify-content-between align-items-center my-3" aria-label="Page navigation">
        <span class="text-muted small">
            Trang <strong>@currentPage</strong> / <strong>@totalPages</strong>
        </span>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="@action" asp-route-page="@(currentPage - 1)">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link font-mono" asp-action="@action" asp-route-page="@i">@i</a>
                </li>
            }
            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="@action" asp-route-page="@(currentPage + 1)">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}
