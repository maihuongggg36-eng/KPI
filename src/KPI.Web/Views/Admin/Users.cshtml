@model List<KPI.Application.DTOs.UserManagementDto>
@{
    ViewData["Title"] = "Quản lý Người dùng & Phân quyền";
    var departments = ViewBag.Departments as List<KPI.Domain.Entities.Organization.Department> ?? new();
    var positions = ViewBag.Positions as List<KPI.Domain.Entities.Organization.Position> ?? new();
    var roles = ViewBag.Roles as List<KPI.Domain.Entities.Identity.Role> ?? new();
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Trang chủ</a></li>
                    <li class="breadcrumb-item text-muted">Quản trị Hệ thống (ADMIN)</li>
                    <li class="breadcrumb-item active fw-bold text-primary">Quản lý Người dùng</li>
                </ol>
            </nav>
            <h2 class="h3 fw-bold mb-0 text-dark"><i class="bi bi-people-fill text-primary me-2"></i>Quản lý Tài khoản & Nhân sự Hệ thống</h2>
            <p class="text-muted small mb-0">Chỉ ADMIN có toàn quyền chỉnh sửa thông tin, phân quyền chức vụ, và cấp lại mật khẩu cho tất cả người dùng.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stat Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 bg-primary text-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-white-50 small text-uppercase fw-semibold">Tổng tài khoản</div>
                        <div class="h3 fw-bold mb-0">@Model.Count</div>
                    </div>
                    <div class="rounded-circle p-3 bg-white bg-opacity-25">
                        <i class="bi bi-person-badge fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 bg-success text-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-white-50 small text-uppercase fw-semibold">Đang hoạt động</div>
                        <div class="h3 fw-bold mb-0">@Model.Count(u => !u.IsLocked)</div>
                    </div>
                    <div class="rounded-circle p-3 bg-white bg-opacity-25">
                        <i class="bi bi-check2-circle fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 bg-danger text-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-white-50 small text-uppercase fw-semibold">Tài khoản bị khóa</div>
                        <div class="h3 fw-bold mb-0">@Model.Count(u => u.IsLocked)</div>
                    </div>
                    <div class="rounded-circle p-3 bg-white bg-opacity-25">
                        <i class="bi bi-lock-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 bg-info text-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-white-50 small text-uppercase fw-semibold">Phòng ban / Khoa</div>
                        <div class="h3 fw-bold mb-0">@departments.Count</div>
                    </div>
                    <div class="rounded-circle p-3 bg-white bg-opacity-25">
                        <i class="bi bi-diagram-3-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Users" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="searchTerm" class="form-control border-start-0" placeholder="Tìm theo tên đăng nhập, họ tên, email..." value="@ViewBag.SearchTerm" />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="departmentId" class="form-select">
                        <option value="">-- Tất cả Phòng ban / Đơn vị --</option>
                        @foreach (var d in departments)
                        {
                            <option value="@d.Id" selected="@(ViewBag.DepartmentId == d.Id)">@d.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-3 flex-grow-1"><i class="bi bi-filter me-1"></i>Lọc danh sách</button>
                    <a asp-action="Users" class="btn btn-outline-secondary" title="Đặt lại bộ lọc"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Users Table Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark"><i class="bi bi-table me-2 text-primary"></i>Danh sách Tài khoản Người dùng (@Model.Count)</span>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">ADMIN Full Control</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-3" style="width: 50px;">ID</th>
                            <th>Họ & Tên / Tài khoản</th>
                            <th>Mã CB</th>
                            <th>Phòng ban / Đơn vị</th>
                            <th>Chức vụ</th>
                            <th>Vai trò</th>
                            <th>Tuổi / Ngày sinh</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-3" style="width: 230px;">Hành động (ADMIN)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    Không tìm thấy tài khoản người dùng phù hợp.
                                </td>
                            </tr>
                        }
                        @foreach (var u in Model)
                        {
                            var roleBadge = u.RoleCode switch
                            {
                                "ADMIN" => "bg-danger",
                                "DIRECTOR" => "bg-primary",
                                "MANAGER" => "bg-warning text-dark",
                                "HR_ADMIN" => "bg-info text-dark",
                                "ACCOUNTANT" => "bg-success",
                                _ => "bg-secondary"
                            };

                            <tr>
                                <td class="ps-3 fw-bold text-muted">#@u.Id</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-initial rounded-circle bg-primary bg-opacity-10 text-primary fw-bold d-flex align-items-center justify-content-center me-3" style="width: 38px; height: 38px;">
                                            @(u.FullName.Length > 0 ? u.FullName.Substring(0, 1).ToUpper() : "U")
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@u.FullName</div>
                                            <div class="small text-muted">@@@u.Username &bull; @u.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge bg-light text-dark border">@u.StaffCode</span></td>
                                <td><span class="text-secondary small fw-medium">@u.DepartmentName</span></td>
                                <td><span class="text-dark small">@u.PositionName</span></td>
                                <td><span class="badge @roleBadge px-2 py-1">@u.RoleName</span></td>
                                <td>
                                    <span class="small text-muted">
                                        @(u.DateOfBirth.HasValue ? $"{u.DateOfBirth.Value:dd/MM/yyyy} ({u.Age} tuổi)" : "Chưa cập nhật")
                                    </span>
                                </td>
                                <td>
                                    @if (u.IsLocked)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-lock-fill me-1"></i>Đang Khóa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle-fill me-1"></i>Hoạt động</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <!-- Nút Sửa thông tin -->
                                        <button type="button" class="btn btn-outline-primary" title="Sửa tên, tuổi, phòng ban, vai trò"
                                                onclick="openEditUserModal(@u.Id, '@Html.Raw(u.FullName)', '@u.Email', '@u.Phone', '@(u.DateOfBirth.HasValue ? u.DateOfBirth.Value.ToString("yyyy-MM-dd") : "")', @(u.DepartmentId ?? 0), @(u.PositionId ?? 0), '@u.RoleCode')">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </button>
                                        <!-- Nút Cấp lại mật khẩu -->
                                        <button type="button" class="btn btn-outline-warning" title="Cấp lại mật khẩu"
                                                onclick="openResetPwdModal(@u.Id, '@u.Username', '@Html.Raw(u.FullName)')">
                                            <i class="bi bi-key-fill"></i> Reset
                                        </button>
                                        <!-- Nút Khóa / Mở khóa -->
                                        <form method="post" asp-action="ToggleLock" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn thay đổi trạng thái khóa của tài khoản này?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.Id" />
                                            @if (u.IsLocked)
                                            {
                                                <button type="submit" class="btn btn-outline-success" title="Mở khóa tài khoản">
                                                    <i class="bi bi-unlock-fill"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-outline-danger" title="Khóa tài khoản">
                                                    <i class="bi bi-lock-fill"></i>
                                                </button>
                                            }
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal 1: Chỉnh sửa thông tin User (Tên, tuổi, phòng ban, chức danh, vai trò) -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-action="EditUser">
                @Html.AntiForgeryToken()
                <input type="hidden" name="UserId" id="editUserId" />
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-person-gear me-2"></i>Chỉnh sửa Thông tin Người dùng (ADMIN)</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                            <input type="text" name="FullName" id="editFullName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email cơ quan <span class="text-danger">*</span></label>
                            <input type="email" name="Email" id="editEmail" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Số điện thoại liên hệ</label>
                            <input type="text" name="Phone" id="editPhone" class="form-control" placeholder="0912xxxxxx" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Ngày sinh (Tính tuổi)</label>
                            <input type="date" name="DateOfBirth" id="editDob" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Phòng ban / Đơn vị trực thuộc <span class="text-danger">*</span></label>
                            <select name="DepartmentId" id="editDept" class="form-select" required>
                                @foreach (var d in departments)
                                {
                                    <option value="@d.Id">@d.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Chức danh vị trí việc làm <span class="text-danger">*</span></label>
                            <select name="PositionId" id="editPos" class="form-select" required>
                                @foreach (var p in positions)
                                {
                                    <option value="@p.Id">@p.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Phân quyền Vai trò (Role) <span class="text-danger">*</span></label>
                            <select name="RoleCode" id="editRole" class="form-select" required>
                                @foreach (var r in roles)
                                {
                                    <option value="@r.Code">@r.Name (@r.Code)</option>
                                }
                            </select>
                            <div class="form-text text-muted">Quyền hạn của vai trò này sẽ do ADMIN thiết lập tại trang Phân quyền Hệ thống.</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i>Lưu thông tin</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 2: Cấp lại mật khẩu (Reset Password) -->
<div class="modal fade" id="resetPwdModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-action="ResetPassword">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" id="resetUserId" />
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold"><i class="bi bi-key-fill me-2"></i>Cấp lại Mật khẩu Người dùng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-3">Bạn đang thực hiện cấp lại mật khẩu cho tài khoản: <strong id="resetUserName" class="text-primary"></strong> (<span id="resetFullName"></span>)</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mật khẩu mới</label>
                        <input type="text" name="newPassword" class="form-control" value="123456" required />
                        <div class="form-text text-muted">Mặc định là <code>123456</code>. Người dùng có thể đổi lại sau khi đăng nhập.</div>
                    </div>
                    <div class="alert alert-info py-2 small mb-0">
                        <i class="bi bi-info-circle me-1"></i>Sau khi cấp lại, số lần nhập sai mật khẩu sẽ được đặt lại về 0 và tài khoản sẽ được mở khóa nếu đang bị khóa.
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-warning px-4 fw-semibold"><i class="bi bi-check-lg me-1"></i>Xác nhận Cấp lại</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditUserModal(id, fullName, email, phone, dob, deptId, posId, roleCode) {
            document.getElementById('editUserId').value = id;
            document.getElementById('editFullName').value = fullName;
            document.getElementById('editEmail').value = email;
            document.getElementById('editPhone').value = phone || '';
            document.getElementById('editDob').value = dob || '';
            document.getElementById('editDept').value = deptId;
            document.getElementById('editPos').value = posId;
            document.getElementById('editRole').value = roleCode;

            var modal = new bootstrap.Modal(document.getElementById('editUserModal'));
            modal.show();
        }

        function openResetPwdModal(id, username, fullName) {
            document.getElementById('resetUserId').value = id;
            document.getElementById('resetUserName').innerText = username;
            document.getElementById('resetFullName').innerText = fullName;

            var modal = new bootstrap.Modal(document.getElementById('resetPwdModal'));
            modal.show();
        }
    </script>
}
