@model List<KPI.Application.DTOs.MenuItemDto>
@{
    ViewData["Title"] = "Quản lý Menu & Đầu mục";
    var permissions = ViewBag.Permissions as List<(string Code, string Module, string Name, string Description)> ?? new();
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
                    <li class="breadcrumb-item text-muted">Quản trị Hệ thống (ADMIN)</li>
                    <li class="breadcrumb-item active fw-bold text-primary">Quản lý Menu & Đầu mục</li>
                </ol>
            </nav>
            <h2 class="h3 fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-menu-button-wide-fill text-primary"></i>
                Quản lý Menu Điều Hướng Động
            </h2>
            <p class="text-muted small mb-0">Chỉ <strong>ADMIN</strong> có toàn quyền Thêm mới, Chỉnh sửa, Xóa, Sắp xếp thứ tự và Bật/Tắt hiển thị các đầu mục trên Sidebar.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-primary px-3 py-2 rounded-3 shadow-sm d-flex align-items-center gap-2" onclick="openCreateMenuModal()">
                <i class="bi bi-plus-circle-fill fs-6"></i>
                <span class="fw-semibold">Thêm Đầu Mục Menu Mới</span>
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-3 d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3 mb-3 d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Info banner -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: linear-gradient(135deg, #f0f7ff 0%, #e0f2fe 100%); border-left: 4px solid var(--color-primary) !important;">
        <div class="card-body p-3 d-flex align-items-start gap-3">
            <div class="rounded-circle bg-white text-primary p-2 shadow-sm d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; flex-shrink: 0;">
                <i class="bi bi-shield-check fs-4"></i>
            </div>
            <div>
                <h6 class="fw-bold text-primary mb-1">Cơ chế Kiểm soát Menu Động từ CSDL (Chỉ dành riêng cho ADMIN):</h6>
                <div class="small text-secondary">
                    - <strong>Thêm/Sửa/Xóa</strong> menu sẽ có tác dụng ngay lập tức trên thanh Sidebar của toàn hệ thống.<br />
                    - Người dùng bình thường chỉ nhìn thấy menu khi menu ở trạng thái <strong>Đang bật</strong> VÀ có <strong>Quyền hạn (Permission)</strong> tương ứng do Admin cấp.<br />
                    - Admin có thể nhấn trực tiếp vào nút trạng thái <span class="badge bg-success-subtle text-success border border-success-subtle">Đang bật</span> / <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Đã tắt</span> trên bảng để Bật/Tắt nhanh 1-Click.
                </div>
            </div>
        </div>
    </div>

    <!-- Menus Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-list-stars text-primary fs-5"></i>
                <span class="fw-bold text-dark fs-6">Danh sách Đầu mục Menu Sidebar</span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">@Model.Count mục</span>
            </div>
            <div class="small text-muted">
                <i class="bi bi-arrow-down-up me-1"></i>Sắp xếp tự động theo <strong>Thứ tự hiển thị</strong>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase" style="background-color: #f8fafc;">
                        <tr>
                            <th class="ps-4 text-center" style="width: 80px;">Thứ tự</th>
                            <th>Icon & Tên Menu</th>
                            <th>Phân nhóm (Section)</th>
                            <th>Đường dẫn (URL / Route)</th>
                            <th>Quyền hạn yêu cầu</th>
                            <th class="text-center" style="width: 140px;">Trạng thái</th>
                            <th class="text-end pe-4" style="width: 200px;">Hành động (ADMIN)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-muted"></i>
                                    Chưa có đầu mục menu nào trong hệ thống. Nhấn "Thêm Đầu Mục Menu Mới" để tạo.
                                </td>
                            </tr>
                        }
                        @foreach (var m in Model)
                        {
                            <tr class="@(!m.IsActive ? "table-light opacity-75" : "")">
                                <td class="ps-4 text-center">
                                    <span class="badge bg-light text-dark border px-2 py-1 font-monospace fw-bold">@m.SortOrder</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-3 p-2 bg-primary-subtle text-primary d-flex align-items-center justify-content-center shadow-xs" style="width: 38px; height: 38px; flex-shrink: 0;">
                                            <i class="bi @(string.IsNullOrEmpty(m.Icon) ? "bi-circle" : m.Icon) fs-5"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@m.Title</div>
                                            <small class="text-muted font-monospace" style="font-size: 11px;">Icon: @(string.IsNullOrEmpty(m.Icon) ? "bi-circle" : m.Icon)</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-white text-secondary border px-2 py-1 rounded-pill shadow-xs">
                                        <i class="bi bi-folder2-open me-1 text-primary"></i>@(string.IsNullOrEmpty(m.SectionTitle) ? "Chung" : m.SectionTitle)
                                    </span>
                                </td>
                                <td>
                                    <code class="text-primary fw-semibold bg-primary-subtle px-2 py-1 rounded">@(m.Url ?? "#")</code>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(m.PermissionCode))
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle font-monospace px-2 py-1">
                                            <i class="bi bi-key me-1"></i>@m.PermissionCode
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border px-2 py-1">
                                            <i class="bi bi-globe me-1"></i>Công khai
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <!-- 1-Click Toggle Active Form -->
                                    <form method="post" asp-action="ToggleMenu" class="d-inline" title="Nhấn để Bật / Tắt nhanh">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@m.Id" />
                                        @if (m.IsActive)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success border-success-subtle rounded-pill px-3 py-1 d-inline-flex align-items-center gap-1 shadow-xs">
                                                <i class="bi bi-check-circle-fill text-success"></i>
                                                <span class="fw-semibold small">Đang bật</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-secondary border-secondary-subtle rounded-pill px-3 py-1 d-inline-flex align-items-center gap-1 shadow-xs">
                                                <i class="bi bi-eye-slash-fill text-secondary"></i>
                                                <span class="fw-semibold small">Đã tắt</span>
                                            </button>
                                        }
                                    </form>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm shadow-xs">
                                        <button type="button" class="btn btn-outline-primary" title="Chỉnh sửa menu"
                                                onclick="openEditMenuModal(@m.Id, '@Html.Raw(m.Title)', '@m.Icon', '@m.Url', '@m.PermissionCode', @m.SortOrder, @(m.IsActive ? "true" : "false"), '@Html.Raw(m.SectionTitle)')">
                                            <i class="bi bi-pencil-square me-1"></i>Sửa
                                        </button>
                                        <form method="post" asp-action="DeleteMenu" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa đầu mục menu này?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@m.Id" />
                                            <button type="submit" class="btn btn-outline-danger" title="Xóa đầu mục menu này">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Thêm / Sửa Menu -->
<div class="modal fade" id="menuModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <form method="post" asp-action="SaveMenu" id="saveMenuForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="menuId" value="0" />
                
                <div class="modal-header bg-primary text-white py-3 px-4">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="menuModalTitle">
                        <i class="bi bi-menu-button-wide"></i>
                        Thêm Đầu Mục Menu Mới
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                
                <div class="modal-body p-4 bg-light">
                    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white mb-3">
                        <div class="row g-3">
                            <!-- 1. Tên Menu -->
                            <div class="col-md-7">
                                <label class="form-label fw-bold text-dark small">Tên hiển thị Menu <span class="text-danger">*</span></label>
                                <input type="text" name="Title" id="menuTitle" class="form-control rounded-3" placeholder="Ví dụ: Bảng lương KPI, Mục tiêu Giám đốc..." required />
                                <div class="form-text text-muted" style="font-size: 11px;">Tên sẽ hiển thị trực tiếp trên thanh điều hướng Sidebar.</div>
                            </div>

                            <!-- 2. Thứ tự hiển thị -->
                            <div class="col-md-5">
                                <label class="form-label fw-bold text-dark small">Thứ tự hiển thị (Sort Order)</label>
                                <input type="number" name="SortOrder" id="menuSort" class="form-control rounded-3" value="1" min="1" max="999" />
                                <div class="form-text text-muted" style="font-size: 11px;">Số nhỏ hơn hiển thị lên trước.</div>
                            </div>

                            <!-- 3. Phân nhóm Section -->
                            <div class="col-md-12">
                                <label class="form-label fw-bold text-dark small">Phân nhóm Menu (Section Title)</label>
                                <input type="text" name="SectionTitle" id="menuSection" class="form-control rounded-3" placeholder="Nhập tên nhóm hoặc chọn nhanh bên dưới..." />
                                
                                <!-- Gợi ý chọn nhanh -->
                                <div class="mt-2 d-flex flex-wrap gap-1 align-items-center">
                                    <span class="small text-muted me-1" style="font-size: 11px;">Gợi ý nhóm nhanh:</span>
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 11px;" onclick="setSectionQuick('Tổng quan')">Tổng quan</button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 11px;" onclick="setSectionQuick('Kế hoạch & Giao KPI')">Kế hoạch & Giao KPI</button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 11px;" onclick="setSectionQuick('Chấm công & Kỷ luật')">Chấm công & Kỷ luật</button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 11px;" onclick="setSectionQuick('Đánh giá & Thẩm định')">Đánh giá & Thẩm định</button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 11px;" onclick="setSectionQuick('Nghị định 90 & 48')">Nghị định 90 & 48</button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 11px;" onclick="setSectionQuick('Lương 3P & Chi trả')">Lương 3P & Chi trả</button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 11px;" onclick="setSectionQuick('Báo cáo & Phân tích')">Báo cáo & Phân tích</button>
                                    <button type="button" class="btn btn-xs btn-outline-primary rounded-pill py-0 px-2 fw-semibold" style="font-size: 11px;" onclick="setSectionQuick('Quản trị Hệ thống (ADMIN)')">Quản trị Hệ thống (ADMIN)</button>
                                </div>
                            </div>

                            <!-- 4. Đường dẫn URL / Route -->
                            <div class="col-md-7">
                                <label class="form-label fw-bold text-dark small">Đường dẫn URL / Route <span class="text-danger">*</span></label>
                                <input type="text" name="Url" id="menuUrl" class="form-control rounded-3 font-monospace" placeholder="/Controller/Action (Ví dụ: /Payroll/Index)" list="commonRoutes" required />
                                <datalist id="commonRoutes">
                                    <option value="/Dashboard/Index">Bàn làm việc Dashboard</option>
                                    <option value="/KpiPlanning/DirectorTargets">Mục tiêu Ban Giám đốc</option>
                                    <option value="/KpiPlanning/MyKpi">KPI Của Tôi</option>
                                    <option value="/KpiPlanning/Assign">Giao Chỉ Tiêu</option>
                                    <option value="/Attendance/Index">Bảng Chấm Công</option>
                                    <option value="/Evaluation/SelfAssess">Tự đánh giá</option>
                                    <option value="/Evaluation/ManagerList">Quản lý Thẩm định</option>
                                    <option value="/Evaluation/DirectorList">Lãnh đạo Phê duyệt</option>
                                    <option value="/CivilServant/Index">Xếp loại CBCC NĐ 90</option>
                                    <option value="/Payroll/Index">Tính lương KPI (P3)</option>
                                    <option value="/Payroll/CashSheet">Ký nhận Tiền mặt</option>
                                    <option value="/Payroll/MyPayslip">Phiếu lương Cá nhân</option>
                                    <option value="/Report/Index">Báo cáo & Chuông Gauss</option>
                                    <option value="/Admin/Users">Quản lý Người dùng (Admin)</option>
                                    <option value="/Admin/Menus">Quản lý Menu Đầu mục (Admin)</option>
                                    <option value="/Admin/Permissions">Phân quyền Hệ thống (Admin)</option>
                                    <option value="/Admin/AuditLog">Nhật ký Kiểm toán (Admin)</option>
                                </datalist>
                                <div class="form-text text-muted" style="font-size: 11px;">Đường dẫn tương đối khi người dùng nhấp vào menu.</div>
                            </div>

                            <!-- 5. Icon Bootstrap với Live Preview -->
                            <div class="col-md-5">
                                <label class="form-label fw-bold text-dark small">Bootstrap Icon</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white" id="iconPreviewBox" style="width: 44px; text-align: center;">
                                        <i class="bi bi-circle text-primary fs-5" id="liveIconPreview"></i>
                                    </span>
                                    <input type="text" name="Icon" id="menuIcon" class="form-control font-monospace" placeholder="bi-grid-fill" oninput="updateIconPreview(this.value)" />
                                </div>
                                <div class="form-text text-muted" style="font-size: 11px;">Ví dụ: <code>bi-grid-fill</code>, <code>bi-cash-stack</code>, <code>bi-people-fill</code></div>
                            </div>

                            <!-- 6. Quyền hạn cần có -->
                            <div class="col-md-12">
                                <label class="form-label fw-bold text-dark small">Quyền hạn yêu cầu (PermissionCode)</label>
                                <select name="PermissionCode" id="menuPerm" class="form-select rounded-3">
                                    <option value="">-- Không yêu cầu (Hiển thị cho tất cả cán bộ) --</option>
                                    @foreach (var p in permissions)
                                    {
                                        <option value="@p.Code">[@p.Module] @p.Name (@p.Code)</option>
                                    }
                                </select>
                                <div class="form-text text-muted" style="font-size: 11px;">
                                    <i class="bi bi-info-circle me-1 text-primary"></i>Nếu gán quyền, chỉ những User/Role được Admin cấp quyền này mới thấy menu trên Sidebar. Admin luôn thấy tất cả menu.
                                </div>
                            </div>

                            <!-- 7. Trạng thái Kích hoạt -->
                            <div class="col-md-12 pt-2 border-top">
                                <div class="form-check form-switch d-flex align-items-center gap-3">
                                    <!-- Hidden input fallback for checkbox in ASP.NET Core -->
                                    <input type="hidden" name="IsActive" value="false" />
                                    <input class="form-check-input fs-5 m-0" type="checkbox" name="IsActive" id="menuActive" value="true" checked />
                                    <div>
                                        <label class="form-check-label fw-bold text-dark" for="menuActive" style="cursor: pointer;">
                                            Kích hoạt hiển thị Menu trên hệ thống
                                        </label>
                                        <div class="text-muted small" style="font-size: 11px;">Nếu tắt, menu này sẽ bị ẩn ngay lập tức đối với tất cả người dùng.</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-white py-3 px-4 border-top">
                    <button type="button" class="btn btn-light rounded-3 px-3 fw-semibold text-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x me-1"></i>Hủy bỏ
                    </button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4 fw-semibold shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i>Lưu Đầu Mục Menu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateIconPreview(iconVal) {
            var iconEl = document.getElementById('liveIconPreview');
            var cleanIcon = (iconVal || '').trim();
            if (!cleanIcon) {
                iconEl.className = 'bi bi-circle text-primary fs-5';
                return;
            }
            if (!cleanIcon.startsWith('bi-') && !cleanIcon.startsWith('bi ')) {
                cleanIcon = 'bi-' + cleanIcon;
            }
            iconEl.className = 'bi ' + cleanIcon + ' text-primary fs-5';
        }

        function setSectionQuick(sectionName) {
            document.getElementById('menuSection').value = sectionName;
        }

        function openCreateMenuModal() {
            document.getElementById('menuModalTitle').innerHTML = '<i class="bi bi-plus-circle me-2"></i>Thêm Đầu Mục Menu Mới';
            document.getElementById('menuId').value = 0;
            document.getElementById('menuTitle').value = '';
            document.getElementById('menuSection').value = 'Kế hoạch & Giao KPI';
            document.getElementById('menuUrl').value = '';
            document.getElementById('menuIcon').value = 'bi-circle';
            document.getElementById('menuPerm').value = '';
            document.getElementById('menuSort').value = @(Model.Count + 1);
            document.getElementById('menuActive').checked = true;
            updateIconPreview('bi-circle');

            var modal = new bootstrap.Modal(document.getElementById('menuModal'));
            modal.show();
        }

        function openEditMenuModal(id, title, icon, url, perm, sort, active, section) {
            document.getElementById('menuModalTitle').innerHTML = '<i class="bi bi-pencil-square me-2"></i>Chỉnh sửa Đầu Mục Menu';
            document.getElementById('menuId').value = id;
            document.getElementById('menuTitle').value = title;
            document.getElementById('menuSection').value = section || '';
            document.getElementById('menuUrl').value = url || '';
            document.getElementById('menuIcon').value = icon || '';
            document.getElementById('menuPerm').value = perm || '';
            document.getElementById('menuSort').value = sort;
            document.getElementById('menuActive').checked = (active === true || active === 'true');
            updateIconPreview(icon || 'bi-circle');

            var modal = new bootstrap.Modal(document.getElementById('menuModal'));
            modal.show();
        }
    </script>
}

