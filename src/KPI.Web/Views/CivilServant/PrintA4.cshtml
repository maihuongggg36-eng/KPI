@model KPI.Application.DTOs.Form01_02Dto
@{
    Layout = null;
    var isLeadership = Model.IsLeadership;
    var formNum = isLeadership ? "01" : "02";
    var formTitle = isLeadership 
        ? "PHIẾU ĐÁNH GIÁ, XẾP LOẠI CHẤT LƯỢNG CÁN BỘ LÃNH ĐẠO, QUẢN LÝ" 
        : "PHIẾU ĐÁNH GIÁ, XẾP LOẠI CHẤT LƯỢNG CÔNG CHỨC";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@($"Mẫu {formNum} - {Model.FullName} - {Model.Year}")</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        @@page {
            size: A4 portrait;
            margin: 20mm 15mm 20mm 20mm;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Times New Roman', Times, serif;
            font-size: 13.5pt;
            line-height: 1.4;
            color: #000;
            background: #f1f5f9;
        }

        .print-container {
            width: 210mm;
            min-height: 297mm;
            margin: 20px auto;
            padding: 20mm 15mm 20mm 20mm;
            background: #fff;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .no-print-bar {
            width: 210mm;
            margin: 15px auto 0 auto;
            padding: 10px 15px;
            background: #1e293b;
            color: #fff;
            border-radius: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .btn-print {
            background: #2563eb;
            color: #fff;
            border: none;
            padding: 8px 18px;
            border-radius: 6px;
            font-size: 14px;
            cursor: pointer;
            font-weight: 600;
        }

        .btn-back {
            background: #475569;
            color: #fff;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 14px;
            cursor: pointer;
            text-decoration: none;
        }

        .header-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        .header-table td {
            vertical-align: top;
            text-align: center;
        }

        .header-left {
            width: 45%;
        }

        .header-right {
            width: 55%;
        }

        .national-title {
            font-weight: bold;
            font-size: 12.5pt;
        }

        .national-motto {
            font-weight: bold;
            font-size: 13pt;
            border-bottom: 1px solid #000;
            display: inline-block;
            padding-bottom: 2px;
        }

        .sub-decree {
            font-style: italic;
            font-size: 10.5pt;
            margin-top: 5px;
        }

        .main-title {
            text-align: center;
            font-size: 15pt;
            font-weight: bold;
            margin: 15px 0 5px 0;
            text-transform: uppercase;
        }

        .eval-year {
            text-align: center;
            font-weight: bold;
            font-size: 13pt;
            margin-bottom: 20px;
        }

        .section-title {
            font-weight: bold;
            font-size: 13.5pt;
            margin: 15px 0 8px 0;
            text-transform: uppercase;
        }

        .info-row {
            margin-bottom: 6px;
            text-align: justify;
        }

        .info-row span.dots {
            border-bottom: 1px dotted #000;
            flex-grow: 1;
        }

        .criteria-table {
            width: 100%;
            border-collapse: collapse;
            margin: 10px 0 15px 0;
            font-size: 12pt;
        }

        .criteria-table th, .criteria-table td {
            border: 1px solid #000;
            padding: 6px 8px;
        }

        .criteria-table th {
            text-align: center;
            font-weight: bold;
            background: #f8fafc;
        }

        .comment-box {
            border: 1px solid #666;
            padding: 8px 12px;
            min-height: 50px;
            font-style: italic;
            margin-top: 5px;
            margin-bottom: 10px;
            text-align: justify;
        }

        .conclusion-highlight {
            border: 2px solid #000;
            padding: 10px;
            text-align: center;
            font-size: 14pt;
            font-weight: bold;
            margin: 15px 0;
            background-color: #fafafa;
        }

        .signature-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 25px;
            page-break-inside: avoid;
        }

        .signature-table td {
            width: 50%;
            vertical-align: top;
            text-align: center;
            padding: 10px 15px;
        }

        .sig-title {
            font-weight: bold;
            text-transform: uppercase;
            font-size: 12.5pt;
        }

        .sig-sub {
            font-style: italic;
            font-size: 11pt;
            margin-bottom: 65px;
        }

        .sig-name {
            font-weight: bold;
            font-size: 13pt;
        }

        @@media print {
            body {
                background: #fff;
            }
            .no-print, .no-print-bar {
                display: none !important;
            }
            .print-container {
                width: 100%;
                margin: 0;
                padding: 0;
                box-shadow: none;
            }
        }
    </style>
</head>
<body>

    <!-- TOOLBAR (Hidden when printing) -->
    <div class="no-print-bar">
        <div>
            <strong>Mẫu số @formNum</strong> &bull; Văn bản chuẩn hành chính Nghị định 90/2020 & 48/2023
        </div>
        <div style="display: flex; gap: 10px;">
            <button onclick="window.print()" class="btn-print">
                <i class="bi bi-printer"></i> In Văn Bản (Ctrl + P)
            </button>
            <a href="/CivilServant/Form01_02?employeeId=@Model.EmployeeId&periodId=@Model.PeriodId" class="btn-back">
                Đóng / Quay lại
            </a>
        </div>
    </div>

    <!-- MAIN A4 PAGE CONTAINER -->
    <div class="print-container">
        <!-- ADMINISTRATIVE HEADER -->
        <table class="header-table">
            <tr>
                <td class="header-left">
                    <div style="font-size: 12pt; text-transform: uppercase;">HỌC VIỆN HÀNH CHÍNH QUỐC GIA</div>
                    <div style="font-size: 12pt; font-weight: bold; text-transform: uppercase;">@Model.DepartmentName</div>
                    <div style="font-size: 10.5pt; margin-top: 4px;">Mã CBCC: <strong>@Model.CivilServantCode</strong></div>
                </td>
                <td class="header-right">
                    <div class="national-title">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
                    <div class="national-motto">Độc lập - Tự do - Hạnh phúc</div>
                    <div class="sub-decree">
                        Mẫu số @formNum (Ban hành kèm theo NĐ số 90/2020/NĐ-CP<br/>và sửa đổi bổ sung bởi NĐ số 48/2023/NĐ-CP)
                    </div>
                </td>
            </tr>
        </table>

        <!-- TITLE -->
        <div class="main-title">@formTitle</div>
        <div class="eval-year">Năm đánh giá: @Model.Year (@Model.PeriodName)</div>

        <!-- PHẦN I: THÔNG TIN CÔNG CHỨC -->
        <div class="section-title">I. THÔNG TIN CỦA CÁN BỘ, CÔNG CHỨC</div>
        
        <div class="info-row">
            - Họ và tên: <strong>@Model.FullName</strong>
        </div>
        <div class="info-row">
            - Ngày, tháng, năm sinh: <strong>@Model.DateOfBirthFormatted</strong>
        </div>
        <div class="info-row">
            - Chức vụ, chức danh: <strong>@Model.PositionName</strong>
        </div>
        <div class="info-row">
            - Cơ quan, đơn vị công tác: <strong>@Model.DepartmentName - Học viện Hành chính Quốc gia</strong>
        </div>
        <div class="info-row">
            - Ngạch công chức: <strong>@Model.RankName</strong> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; - Hệ số lương: <strong>@Model.SalaryCoefficient.ToString("F2")</strong>
        </div>
        <div class="info-row">
            - Đảng viên: <strong>@Model.PartyStatusName</strong>
        </div>

        <!-- PHẦN II: KẾT QUẢ ĐÁNH GIÁ THEO TIÊU CHÍ -->
        <div class="section-title">II. KẾT QUẢ THẨM ĐỊNH CÁC TIÊU CHÍ CHẤT LƯỢNG</div>
        <table class="criteria-table">
            <thead>
                <tr>
                    <th style="width: 8%;">STT</th>
                    <th style="width: 67%;">Nội dung tiêu chí theo Nghị định Chính phủ</th>
                    <th style="width: 10%;">Trọng số</th>
                    <th style="width: 15%;">Điểm đạt</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td style="text-align: center;">1</td>
                    <td>Chính trị tư tưởng, phẩm chất đạo đức, lối sống</td>
                    <td style="text-align: center;">15%</td>
                    <td style="text-align: center; font-weight: bold;">@Model.PoliticalEthicsScore</td>
                </tr>
                <tr>
                    <td style="text-align: center;">2</td>
                    <td>Tác phong, lề lối làm việc và ý thức tổ chức kỷ luật</td>
                    <td style="text-align: center;">15%</td>
                    <td style="text-align: center; font-weight: bold;">@Model.WorkDisciplineScore</td>
                </tr>
                <tr>
                    <td style="text-align: center;">3</td>
                    <td>Kết quả thực hiện chức trách, nhiệm vụ được giao (Điểm KPI)</td>
                    <td style="text-align: center;">@(isLeadership ? "40%" : "55%")</td>
                    <td style="text-align: center; font-weight: bold;">@Model.DutyExecutionScore</td>
                </tr>
                @if (isLeadership)
                {
                    <tr>
                        <td style="text-align: center;">4</td>
                        <td>Năng lực lãnh đạo, quản lý, điều hành và quy tụ đoàn kết đơn vị</td>
                        <td style="text-align: center;">15%</td>
                        <td style="text-align: center; font-weight: bold;">@Model.LeadershipCapacityScore</td>
                    </tr>
                }
                <tr>
                    <td style="text-align: center;">@(isLeadership ? "5" : "4")</td>
                    <td>Tinh thần đổi mới sáng tạo, chuyển đổi số và trách nhiệm nêu gương</td>
                    <td style="text-align: center;">15%</td>
                    <td style="text-align: center; font-weight: bold;">@Model.InnovationScore</td>
                </tr>
                <tr style="background-color: #f1f5f9; font-weight: bold;">
                    <td colspan="3" style="text-align: right; text-transform: uppercase;">Tổng điểm thẩm định quy đổi:</td>
                    <td style="text-align: center; font-size: 13pt;">@Model.TotalCalculatedScore.ToString("F1") / 100</td>
                </tr>
            </tbody>
        </table>

        <!-- PHẦN III: Ý KIẾN TẬP THỂ & CẤP ỦY -->
        <div class="section-title">III. Ý KIẾN CỦA TẬP THỂ ĐƠN VỊ VÀ CẤP ỦY</div>
        <div style="margin-bottom: 6px;">1. Ý kiến đóng góp của tập thể cơ quan, đơn vị nơi công tác:</div>
        <div class="comment-box">
            @(string.IsNullOrWhiteSpace(Model.CollectiveComments) ? "Tập thể thống nhất cao với kết quả công tác và tinh thần trách nhiệm của cán bộ trong kỳ đánh giá." : Model.CollectiveComments)
        </div>

        <div style="margin-bottom: 6px;">2. Ý kiến nhận xét của Chi ủy / Cấp ủy nơi công tác:</div>
        <div class="comment-box">
            @(string.IsNullOrWhiteSpace(Model.PartyOpinion) ? "Chi bộ nhận thấy cán bộ luôn gương mẫu chấp hành tốt đường lối của Đảng, không có biểu hiện suy thoái phẩm chất." : Model.PartyOpinion)
        </div>

        <!-- PHẦN IV: KẾT LUẬN XẾP LOẠI CHẤT LƯỢNG -->
        <div class="section-title">IV. KẾT LUẬN XẾP LOẠI CHẤT LƯỢNG CỦA CẤP CÓ THẨM QUYỀN</div>
        <div class="conclusion-highlight">
            XẾP LOẠI: @Model.FinalizedRank.ToUpper()
        </div>

        @if (Model.HasDisciplinaryAction)
        {
            <div style="font-size: 11pt; color: #b91c1c; font-style: italic; margin-bottom: 10px;">
                * Căn cứ BR-07: Cán bộ có quyết định kỷ luật trong năm công tác, bắt buộc áp dụng mức xếp loại "Không hoàn thành nhiệm vụ".
            </div>
        }
        else if (Model.HasApprovedInitiative && Model.FinalizedRank.Contains("xuất sắc", StringComparison.OrdinalIgnoreCase))
        {
            <div style="font-size: 11pt; font-style: italic; margin-bottom: 10px;">
                * Căn cứ BR-08: Cán bộ có đề tài/sáng kiến cải tiến được Hội đồng khoa học công nhận: <em>@(Model.InitiativeName ?? "Đề tài chuyển đổi số trong quản lý công")</em>.
            </div>
        }

        <!-- CHỮ KÝ VÀ XÁC NHẬN -->
        <table class="signature-table">
            <tr>
                <td>
                    <div class="sig-title">NGƯỜI TỰ NHẬN XÉT</div>
                    <div class="sig-sub">(Ký và ghi rõ họ tên)</div>
                    <div class="sig-name">@Model.FullName</div>
                </td>
                <td>
                    <div class="sig-title">ĐẠI DIỆN TẬP THỂ ĐƠN VỊ</div>
                    <div class="sig-sub">(Ký và ghi rõ họ tên)</div>
                    <div class="sig-name">Lãnh đạo đơn vị</div>
                </td>
            </tr>
            <tr>
                <td style="padding-top: 30px;">
                    <div class="sig-title">ĐẠI DIỆN CẤP ỦY</div>
                    <div class="sig-sub">(Ký và ghi rõ họ tên)</div>
                    <div class="sig-name">Bí thư Chi bộ</div>
                </td>
                <td style="padding-top: 30px;">
                    <div class="sig-title">NGƯỜI CÓ THẨM QUYỀN ĐÁNH GIÁ</div>
                    <div class="sig-sub">(Ký tên, đóng dấu)</div>
                    <div class="sig-name">GIÁM ĐỐC HỌC VIỆN</div>
                </td>
            </tr>
        </table>
    </div>

</body>
</html>
