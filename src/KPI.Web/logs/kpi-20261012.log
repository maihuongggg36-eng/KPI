    SELECT [k0].[Id], [k0].[AssignmentId], [k0].[KpiItemId], [k0].[KpiName], [k0].[MaxCap], [k0].[MinThreshold], [k0].[ScoringFormula], [k0].[TargetValue], [k0].[Unit], [k0].[Weight], [t7].[Id] AS [Id0], [t7].[CategoryId], [t7].[Code], [t7].[CreatedAt], [t7].[Description], [t7].[IsActive], [t7].[IsCivilServantOnly], [t7].[IsDeleted], [t7].[MethodId], [t7].[Name], [t7].[ScoringFormula] AS [ScoringFormula0], [t7].[UnitId], [t8].[Id] AS [Id1], [t8].[Code] AS [Code0], [t8].[DisplayOrder], [t8].[IsDeleted] AS [IsDeleted0], [t8].[Name] AS [Name0], [t8].[Perspective], [t8].[TargetSector], [k2].[Id] AS [Id2], [k2].[AssignmentDetailId], [k2].[Description] AS [Description0], [k2].[FileName], [k2].[FilePath], [k2].[FileSize], [k2].[FileType], [k2].[UploadedAt]
    FROM [kpi_assignment_details] AS [k0]
    INNER JOIN (
        SELECT [k1].[Id], [k1].[CategoryId], [k1].[Code], [k1].[CreatedAt], [k1].[Description], [k1].[IsActive], [k1].[IsCivilServantOnly], [k1].[IsDeleted], [k1].[MethodId], [k1].[Name], [k1].[ScoringFormula], [k1].[UnitId]
        FROM [kpi_master_items] AS [k1]
        WHERE [k1].[IsDeleted] = CAST(0 AS bit)
    ) AS [t7] ON [k0].[KpiItemId] = [t7].[Id]
    INNER JOIN (
        SELECT [k3].[Id], [k3].[Code], [k3].[DisplayOrder], [k3].[IsDeleted], [k3].[Name], [k3].[Perspective], [k3].[TargetSector]
        FROM [kpi_categories] AS [k3]
        WHERE [k3].[IsDeleted] = CAST(0 AS bit)
    ) AS [t8] ON [t7].[CategoryId] = [t8].[Id]
    LEFT JOIN [kpi_evidences] AS [k2] ON [k0].[Id] = [k2].[AssignmentDetailId]
) AS [t6] ON [t5].[Id] = [t6].[AssignmentId]
ORDER BY [t5].[Id], [t5].[Id0], [t5].[Id1], [t5].[Id2], [t5].[Id3], [t5].[Id4], [t5].[Id5], [t6].[Id], [t6].[Id0], [t6].[Id1]
